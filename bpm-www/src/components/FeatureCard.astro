---
interface Props {
  icon: string
  name: string
  desc: string
}
const { icon, name, desc } = Astro.props
---
<div class="rounded-xl border border-brand-rule/70 bg-white p-5">
  <div class="flex items-baseline gap-3">
    <span class="text-xl" aria-hidden="true">{icon}</span>
    <h3 class="font-display text-lg font-semibold text-brand-midnight">{name}</h3>
  </div>
  <p class="mt-2 text-sm leading-relaxed text-brand-night/80">{desc}</p>
</div>
