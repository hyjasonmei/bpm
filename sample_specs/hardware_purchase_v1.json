{
  "meta": {
    "schemaVersion": "1.0",
    "tenant": "acme",
    "flowName": "硬體採購",
    "flowCode": "HW_PURCHASE",
    "flowVersion": 1,
    "createdAt": "2026-05-11T00:00:00Z",
    "createdBy": "u_demo",
    "language": "zh-TW"
  },
  "flow": {
    "nodes": [
      { "id": "start_1", "type": "startEvent", "label": "開始" },
      { "id": "task_request", "type": "userTask", "label": "員工申請" },
      { "id": "approval_it", "type": "approval", "label": "IT 核准" },
      { "id": "gateway_grand", "type": "gateway", "label": "總額 ≥ 10 萬？" },
      { "id": "approval_finance", "type": "approval", "label": "財務核准" },
      { "id": "task_purchase_exec", "type": "userTask", "label": "採購處理" },
      { "id": "end_1", "type": "endEvent", "label": "完成" }
    ],
    "edges": [
      { "id": "e1", "source": "start_1", "target": "task_request" },
      { "id": "e2", "source": "task_request", "target": "approval_it" },
      { "id": "e3", "source": "approval_it", "target": "gateway_grand" },
      { "id": "e4", "source": "gateway_grand", "target": "approval_finance", "condition": "grand_total >= 100000", "label": "10 萬以上需財務核" },
      { "id": "e5", "source": "gateway_grand", "target": "task_purchase_exec", "condition": "grand_total < 100000", "isDefault": true, "label": "10 萬以下直接採購" },
      { "id": "e6", "source": "approval_finance", "target": "task_purchase_exec" },
      { "id": "e7", "source": "task_purchase_exec", "target": "end_1" }
    ]
  },
  "userTasks": [
    {
      "id": "task_request",
      "formCode": "HW_PURCHASE_REQUEST",
      "fields": [
        { "id": "vendor", "label": { "zh-TW": "供應商" }, "type": "text", "required": true },
        { "id": "category", "label": { "zh-TW": "用途", "en": "Category" }, "type": "select", "required": true,
          "options": [
            { "value": "capex", "label": "資本支出 (CapEx)" },
            { "value": "opex",  "label": "費用支出 (OpEx)" }
          ] },
        { "id": "hw_items", "label": { "zh-TW": "硬體明細" }, "type": "textarea", "required": true,
          "hint": { "zh-TW": "後台展開為 [{ name, qty, unit_price, line_total }]，line_total 由 derivedFrom 計算" } },
        { "id": "grand_total", "label": { "zh-TW": "總金額" }, "type": "derived", "required": false,
          "derivedFrom": "sum(hw_items.line_total)" },
        { "id": "justification", "label": { "zh-TW": "採購理由" }, "type": "textarea", "required": true,
          "validator": "value != ''" },
        { "id": "quote_file", "label": { "zh-TW": "報價單" }, "type": "file", "required": true,
          "conditional": "grand_total >= 30000" }
      ],
      "permissions": { "submitter": "self", "viewers": ["self", "manager", "role:IT", "role:Finance"] }
    },
    {
      "id": "task_purchase_exec",
      "formCode": "HW_PURCHASE_EXEC",
      "fields": [
        { "id": "po_number", "label": { "zh-TW": "採購單號" }, "type": "text", "required": true },
        { "id": "expected_delivery", "label": { "zh-TW": "預計到貨日" }, "type": "date", "required": true }
      ],
      "permissions": { "submitter": "role:Purchase", "viewers": ["self", "role:Purchase", "role:Finance"] }
    }
  ],
  "decisions": [
    {
      "id": "gateway_grand",
      "type": "exclusive",
      "branches": [
        { "edgeId": "e4", "condition": "grand_total >= 100000" },
        { "edgeId": "e5", "condition": "grand_total < 100000", "isDefault": true }
      ]
    }
  ],
  "approvals": [
    { "id": "approval_it",      "approver": { "type": "role", "code": "IT" } },
    { "id": "approval_finance", "approver": { "type": "role", "code": "Finance" } }
  ],
  "notifications": [
    {
      "id": "notify_assign",
      "trigger": "on_assign",
      "channel": ["email", "in_app"],
      "recipients": [{ "type": "current_approver" }],
      "template": {
        "subject": { "zh-TW": "【硬體採購待簽】{{applicant.name}} - {{purchase.grandTotal}}" },
        "body": { "zh-TW": "申請人: {{applicant.name}}\n供應商: {{purchase.vendor}}\n總額: {{purchase.grandTotal}}\n\n請核准: {{caseUrl}}" },
        "variables": ["applicant.name", "purchase.vendor", "purchase.grandTotal", "caseUrl"]
      }
    }
  ],
  "sla": {
    "perNode": {
      "approval_it": { "duration": "16h", "businessHoursOnly": true, "escalation": { "after": "16h", "action": "notify" } },
      "approval_finance": { "duration": "24h", "businessHoursOnly": true, "escalation": { "after": "24h", "action": "notify" } }
    }
  },
  "integrations": {
    "identityProvider": "csv",
    "csvSource": { "url": "s3://bpm-tenants/acme/employees-2026-05-11.csv" },
    "fieldMappings": {
      "employeeId": "empId",
      "displayName": "name",
      "email": "email",
      "reportsTo": "manager",
      "department": "department",
      "title": "title"
    }
  },
  "testCases": [
    {
      "id": "tc_small",
      "name": "1 台筆電 35,000 元，IT 核即可",
      "inputs": {
        "vendor": "Apple Authorized",
        "category": "opex",
        "hw_items": [
          { "name": "MacBook Air M3 13", "qty": 1, "unit_price": 35000, "line_total": 35000 }
        ],
        "justification": "新進工程師配機",
        "quote_file": "quote_35k.pdf"
      },
      "expectedPath": ["start_1", "task_request", "approval_it", "gateway_grand", "task_purchase_exec", "end_1"],
      "expectedApprovers": [{ "nodeId": "approval_it", "userIds": ["u_it_lead"] }]
    },
    {
      "id": "tc_large",
      "name": "10 台筆電 350,000 元，IT + 財務都要核",
      "inputs": {
        "vendor": "Apple Authorized",
        "category": "capex",
        "hw_items": [
          { "name": "MacBook Pro 14 M4", "qty": 10, "unit_price": 35000, "line_total": 350000 }
        ],
        "justification": "Q3 工程團隊擴編",
        "quote_file": "quote_350k.pdf"
      },
      "expectedPath": ["start_1", "task_request", "approval_it", "gateway_grand", "approval_finance", "task_purchase_exec", "end_1"],
      "expectedApprovers": [
        { "nodeId": "approval_it", "userIds": ["u_it_lead"] },
        { "nodeId": "approval_finance", "userIds": ["u_finance_lead"] }
      ]
    }
  ]
}
