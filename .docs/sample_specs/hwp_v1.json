{
  "meta": {
    "schemaVersion": "1.0",
    "tenant": "acme",
    "flowName": "硬體採購申請",
    "flowCode": "HWP",
    "flowVersion": 1,
    "createdAt": "2026-05-11T00:00:00Z",
    "createdBy": "u_demo",
    "language": "zh-TW",
    "notes": "Per workflow.ts HWP: employee → it × 2 (it_spec, quote) → manager × 2 (confirm userTask, approve approval) → finance(po) → close. Renamed from hardware_purchase_v1.json (flowCode HW_PURCHASE) to align with workflow.ts FormCode HWP. Line items collapsed to scalars for v1; original threshold gateway moved to per-line approval if needed in v2."
  },
  "flow": {
    "nodes": [
      { "id": "start_1", "type": "startEvent", "label": "開始" },
      { "id": "task_apply", "type": "userTask", "label": "員工申請" },
      { "id": "task_it_spec", "type": "userTask", "label": "IT 規格審查" },
      { "id": "task_it_quote", "type": "userTask", "label": "比價報價" },
      { "id": "task_confirm", "type": "userTask", "label": "確認列印" },
      { "id": "approval_manager", "type": "approval", "label": "主管簽核" },
      { "id": "task_finance_po", "type": "userTask", "label": "採購單處理" },
      { "id": "end_1", "type": "endEvent", "label": "結案" }
    ],
    "edges": [
      { "id": "e1", "source": "start_1", "target": "task_apply" },
      { "id": "e2", "source": "task_apply", "target": "task_it_spec" },
      { "id": "e3", "source": "task_it_spec", "target": "task_it_quote" },
      { "id": "e4", "source": "task_it_quote", "target": "task_confirm" },
      { "id": "e5", "source": "task_confirm", "target": "approval_manager" },
      { "id": "e6", "source": "approval_manager", "target": "task_finance_po" },
      { "id": "e7", "source": "task_finance_po", "target": "end_1" }
    ]
  },
  "userTasks": [
    {
      "id": "task_apply",
      "formCode": "HWP_APPLY",
      "fields": [
        {
          "id": "category",
          "label": { "zh-TW": "硬體類別", "en": "Category" },
          "type": "select",
          "required": true,
          "options": [
            { "value": "laptop", "label": "Notebook / Laptop" },
            { "value": "desktop", "label": "Desktop" },
            { "value": "monitor", "label": "Monitor" },
            { "value": "peripheral", "label": "Peripheral" },
            { "value": "server", "label": "Server" },
            { "value": "other", "label": "其他" }
          ]
        },
        { "id": "item_name", "label": { "zh-TW": "商品名稱", "en": "Item" }, "type": "text", "required": true, "hint": { "zh-TW": "E.g. MacBook Air M3 13" } },
        { "id": "spec", "label": { "zh-TW": "規格", "en": "Spec" }, "type": "textarea", "required": true, "hint": { "zh-TW": "E.g. 13\" / RAM 16GB / SSD 512GB" } },
        { "id": "qty", "label": { "zh-TW": "數量", "en": "Qty" }, "type": "number", "required": true, "validator": "value > 0" },
        { "id": "shipping_loc", "label": { "zh-TW": "送貨地點", "en": "Shipping Location" }, "type": "text", "required": true },
        {
          "id": "purpose",
          "label": { "zh-TW": "用途", "en": "Purpose" },
          "type": "select",
          "required": true,
          "options": [
            { "value": "new_hire", "label": "新人配機" },
            { "value": "replacement", "label": "汰換" },
            { "value": "additional", "label": "增購" },
            { "value": "project", "label": "專案需求" },
            { "value": "other", "label": "其他" }
          ]
        },
        { "id": "expected_date", "label": { "zh-TW": "預計到貨日", "en": "Expected Date" }, "type": "date", "required": false }
      ],
      "permissions": { "submitter": "self", "viewers": ["self", "manager", "role:IT", "role:Finance"] }
    },
    {
      "id": "task_it_spec",
      "formCode": "HWP_IT_SPEC",
      "fields": [
        { "id": "spec_review", "label": { "zh-TW": "規格審查意見" }, "type": "textarea", "required": true },
        {
          "id": "spec_decision",
          "label": { "zh-TW": "審查結果" },
          "type": "select",
          "required": true,
          "options": [
            { "value": "approved", "label": "核准" },
            { "value": "needs_change", "label": "需修改" }
          ]
        }
      ],
      "permissions": { "submitter": "role:IT", "viewers": ["role:IT", "self", "manager"] }
    },
    {
      "id": "task_it_quote",
      "formCode": "HWP_QUOTE",
      "fields": [
        { "id": "vendor_name", "label": { "zh-TW": "廠商" }, "type": "text", "required": true },
        { "id": "unit_price", "label": { "zh-TW": "單價" }, "type": "number", "required": true, "validator": "value > 0" },
        { "id": "line_total", "label": { "zh-TW": "小計" }, "type": "number", "required": true, "validator": "value > 0" },
        { "id": "quote_no", "label": { "zh-TW": "報價單號" }, "type": "text", "required": true },
        { "id": "quote_file", "label": { "zh-TW": "報價單" }, "type": "file", "required": true }
      ],
      "permissions": { "submitter": "role:IT", "viewers": ["role:IT", "self", "manager", "role:Finance"] }
    },
    {
      "id": "task_confirm",
      "formCode": "HWP_CONFIRM",
      "fields": [
        { "id": "print_no", "label": { "zh-TW": "列印單號" }, "type": "text", "required": true },
        { "id": "confirm_note", "label": { "zh-TW": "確認備註" }, "type": "textarea", "required": false }
      ],
      "permissions": { "submitter": "manager", "viewers": ["manager", "self", "role:IT"] }
    },
    {
      "id": "task_finance_po",
      "formCode": "HWP_FINANCE_PO",
      "fields": [
        { "id": "po_number", "label": { "zh-TW": "採購單號", "en": "PO Number" }, "type": "text", "required": true },
        { "id": "po_date", "label": { "zh-TW": "採購單日期" }, "type": "date", "required": true },
        { "id": "expected_delivery", "label": { "zh-TW": "預計到貨日" }, "type": "date", "required": true }
      ],
      "permissions": { "submitter": "role:Finance", "viewers": ["role:Finance", "self", "manager", "role:IT"] }
    }
  ],
  "decisions": [],
  "approvals": [
    { "id": "approval_manager", "approver": { "type": "expr", "path": "submitter.manager" } }
  ],
  "notifications": [
    {
      "id": "notify_assign",
      "trigger": "on_assign",
      "channel": ["email", "in_app"],
      "recipients": [{ "type": "current_approver" }],
      "template": {
        "subject": { "zh-TW": "【硬體採購待處理】{{applicant.name}} - {{item.name}} x {{item.qty}}" },
        "body": { "zh-TW": "申請人: {{applicant.name}}\n商品: {{item.name}}\n規格: {{item.spec}}\n數量: {{item.qty}}\n用途: {{item.purpose}}\n\n請點此處理: {{caseUrl}}" },
        "variables": ["applicant.name", "item.name", "item.spec", "item.qty", "item.purpose", "caseUrl"]
      }
    },
    {
      "id": "notify_complete",
      "trigger": "on_complete",
      "channel": ["email"],
      "recipients": [{ "type": "submitter" }],
      "template": {
        "subject": { "zh-TW": "您的硬體採購已完成 PO 開立" },
        "body": { "zh-TW": "您申請的 {{item.name}} x {{item.qty}}，採購單號 {{po.number}} 已開立，預計 {{po.expectedDelivery}} 到貨。" },
        "variables": ["item.name", "item.qty", "po.number", "po.expectedDelivery"]
      }
    }
  ],
  "sla": {
    "perNode": {
      "task_it_spec": { "duration": "16h", "businessHoursOnly": true },
      "task_it_quote": { "duration": "24h", "businessHoursOnly": true },
      "approval_manager": { "duration": "16h", "businessHoursOnly": true, "escalation": { "after": "16h", "action": "notify" } },
      "task_finance_po": { "duration": "48h", "businessHoursOnly": true }
    }
  },
  "integrations": {
    "identityProvider": "csv",
    "csvSource": { "url": "s3://bpm-tenants/acme/employees-2026-05-11.csv" },
    "fieldMappings": {
      "employeeId": "empId",
      "displayName": "name",
      "email": "email",
      "reportsTo": "manager",
      "department": "department",
      "title": "title"
    }
  },
  "testCases": [
    {
      "id": "tc_happy_macbook",
      "name": "1 台 MacBook Air → IT 審 → 比價 → 主管核准 → PO",
      "inputs": {
        "category": "laptop",
        "item_name": "MacBook Air M3 13",
        "spec": "13\" / RAM 16GB / SSD 512GB",
        "qty": 1,
        "shipping_loc": "Taipei office",
        "purpose": "new_hire",
        "expected_date": "2026-06-15"
      },
      "expectedTrace": ["start_1", "task_apply", "task_it_spec", "task_it_quote", "task_confirm", "approval_manager", "task_finance_po", "end_1"],
      "expectedFinalStatus": "Completed",
      "expectedNotifications": [
        { "trigger": "on_assign", "recipientCount": 1 },
        { "trigger": "on_complete", "recipientCount": 1 }
      ]
    },
    {
      "id": "tc_reject_by_manager",
      "name": "主管退件 → 流程結束於 Errored",
      "inputs": {
        "category": "monitor",
        "item_name": "Dell 32 4K",
        "spec": "32\" 4K",
        "qty": 1,
        "shipping_loc": "Taipei",
        "purpose": "additional"
      },
      "managerDecision": "reject",
      "expectedTrace": ["start_1", "task_apply", "task_it_spec", "task_it_quote", "task_confirm", "approval_manager"],
      "expectedFinalStatus": "Errored"
    }
  ]
}
