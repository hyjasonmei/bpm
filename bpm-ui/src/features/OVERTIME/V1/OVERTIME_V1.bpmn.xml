<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="OVERTIME_V1_defs"
                  targetNamespace="http://flowcook.ai/bpmn/OVERTIME/V1">
  <bpmn:process id="OVERTIME_V1_process" isExecutable="false">
    <bpmn:startEvent id="start_1" name="開始">
      <bpmn:outgoing>e1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="task_apply" name="填寫加班申請（日期／時數／事由）">
      <bpmn:incoming>e1</bpmn:incoming>
      <bpmn:outgoing>e2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="approval_manager" name="直屬主管審核">
      <bpmn:incoming>e2</bpmn:incoming>
      <bpmn:outgoing>e3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gateway_approved" name="主管審核結果">
      <bpmn:incoming>e3</bpmn:incoming>
      <bpmn:outgoing>e4</bpmn:outgoing>
      <bpmn:outgoing>e5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gateway_hours" name="單月累計是否超過 20 小時">
      <bpmn:incoming>e4</bpmn:incoming>
      <bpmn:outgoing>e7</bpmn:outgoing>
      <bpmn:outgoing>e8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="approval_hr" name="人資複核">
      <bpmn:incoming>e7</bpmn:incoming>
      <bpmn:outgoing>e9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gateway_hr_result" name="人資複核結果">
      <bpmn:incoming>e9</bpmn:incoming>
      <bpmn:outgoing>e10</bpmn:outgoing>
      <bpmn:outgoing>e11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="notify_reject_manager" name="通知申請人（主管退回）">
      <bpmn:incoming>e5</bpmn:incoming>
      <bpmn:outgoing>e6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="notify_reject_hr" name="通知申請人（人資退回）">
      <bpmn:incoming>e11</bpmn:incoming>
      <bpmn:outgoing>e13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="notify_approve" name="通知申請人（核准）">
      <bpmn:incoming>e8</bpmn:incoming>
      <bpmn:incoming>e10</bpmn:incoming>
      <bpmn:outgoing>e12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end_approved" name="申請核准結束">
      <bpmn:incoming>e12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_rejected_manager" name="主管退回結束">
      <bpmn:incoming>e6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_rejected_hr" name="人資退回結束">
      <bpmn:incoming>e13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="e1" sourceRef="start_1" targetRef="task_apply" />
    <bpmn:sequenceFlow id="e2" sourceRef="task_apply" targetRef="approval_manager" />
    <bpmn:sequenceFlow id="e3" sourceRef="approval_manager" targetRef="gateway_approved" />
    <bpmn:sequenceFlow id="e4" name="核准" sourceRef="gateway_approved" targetRef="gateway_hours" />
    <bpmn:sequenceFlow id="e5" name="退回" sourceRef="gateway_approved" targetRef="notify_reject_manager" />
    <bpmn:sequenceFlow id="e6" sourceRef="notify_reject_manager" targetRef="end_rejected_manager" />
    <bpmn:sequenceFlow id="e7" name="超過 20 小時" sourceRef="gateway_hours" targetRef="approval_hr" />
    <bpmn:sequenceFlow id="e8" name="未超過 20 小時" sourceRef="gateway_hours" targetRef="notify_approve" />
    <bpmn:sequenceFlow id="e9" sourceRef="approval_hr" targetRef="gateway_hr_result" />
    <bpmn:sequenceFlow id="e10" name="核准" sourceRef="gateway_hr_result" targetRef="notify_approve" />
    <bpmn:sequenceFlow id="e11" name="退回" sourceRef="gateway_hr_result" targetRef="notify_reject_hr" />
    <bpmn:sequenceFlow id="e12" sourceRef="notify_approve" targetRef="end_approved" />
    <bpmn:sequenceFlow id="e13" sourceRef="notify_reject_hr" targetRef="end_rejected_hr" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="OVERTIME_V1_diagram">
    <bpmndi:BPMNPlane id="OVERTIME_V1_plane" bpmnElement="OVERTIME_V1_process">
      <bpmndi:BPMNShape id="di_start_1" bpmnElement="start_1">
        <dc:Bounds x="160" y="252" width="36" height="36" />
