---
import BaseLayout from '../layouts/BaseLayout.astro'
import KitchenAct from '../components/KitchenAct.astro'
---
<BaseLayout>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-b from-brand-cream via-brand-cream to-brand-plate/40">
    <div class="container-narrow py-20 sm:py-28">
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 rounded-full border border-brand-flame/30 bg-brand-flame/10 px-3 py-1 text-xs font-mono uppercase tracking-[0.18em] text-brand-flame">
          <span aria-hidden="true">🔥</span>
          AI 廚房 · BPM
        </span>
        <h1 class="mt-6 font-display text-5xl font-semibold leading-[1.1] tracking-tight text-brand-midnight sm:text-6xl">
          你點流程，<br class="hidden sm:block" />
          AI 上菜。
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-brand-night/85 sm:text-xl">
          將商業流程規格料理成代碼，<br class="hidden sm:block" />
          就交給 <strong class="text-brand-flame">Flowcook AI 廚房</strong>。
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-4">
          <a href="#contact" class="btn-flame">預約一份試吃</a>
          <a href="/how-it-works" class="btn-ghost">看一道菜怎麼做 →</a>
        </div>
      </div>
    </div>

    <!-- decorative steam wave -->
    <svg class="pointer-events-none absolute -bottom-1 left-0 w-full text-brand-plate/60" viewBox="0 0 1440 64" fill="currentColor" aria-hidden="true">
      <path d="M0,32 C240,64 480,0 720,32 C960,64 1200,0 1440,32 L1440,64 L0,64 Z" />
    </svg>
  </section>

  <!-- Three acts -->
  <section class="bg-brand-plate/30 py-20 sm:py-28">
    <div class="container-narrow">
      <div class="mb-14 max-w-2xl">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-brand-muted">三道工序，一桌好菜</p>
        <h2 class="mt-3 font-display text-4xl font-semibold leading-tight sm:text-5xl">
          備料、烹調、上菜 —— <br class="hidden sm:block" />
          AI 廚房一條龍。
        </h2>
        <p class="mt-4 text-base text-brand-night/80">
          從你描述「想做請假流程」，到 BPM 真正在公司跑起來。中間每一步，AI 都在。
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6">
        <KitchenAct
          act="prep"
          icon="🥬"
          english="Prep"
          zh="備料"
          headline="AI Kitchen — 把流程描述清楚"
          body="從 PDF、流程圖到老闆口述，AI 邊聊邊問細節。11 道工序覆蓋表單、決策、審核、通知、SLA、整合，最後產出一份精準到能下廚的 spec。"
          note="沒人需要學 BPMN —— 你只需要會講流程怎麼跑。"
        />
        <KitchenAct
          act="cook"
          icon="🔥"
          english="Cook"
          zh="烹調"
          headline="Chef 烹調 —— 寫真實的代碼"
          body="spec 交給 AI chef，他寫真實的 React + .NET，不是低代碼罐頭。每一行可以在 GitHub diff 上 review，code 是你的，未來自己接手也順手。"
          note="沒有 platform lock-in。用得開心也行，想換廚師也行。"
        />
        <KitchenAct
          act="serve"
          icon="🍽"
          english="Serve"
          zh="上菜"
          headline="Sandbox 試吃 → 正式上桌"
          body="假信箱、假時鐘、persona 一鍵切換 —— 一個驗收員就能跑完整 UAT，完全不影響真實系統。試吃滿意，再 push 到正式環境。"
          note="上線那一刻，你心裡是踏實的。"
        />
      </div>
    </div>
  </section>

  <!-- Why flowcook -->
  <section class="py-20 sm:py-28">
    <div class="container-narrow grid grid-cols-1 gap-12 md:grid-cols-3">
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-brand-muted">業界標準</p>
        <h3 class="mt-3 font-display text-2xl font-semibold">不重新發明輪子</h3>
        <p class="mt-3 text-sm leading-relaxed text-brand-night/80">
          BPMN 2.0 描述流程、CEL 寫條件、OpenAPI 描述整合、Entra ID 對接組織 —— 全是業界開放標準。
          沒有奇怪的私有 DSL 綁架你。
        </p>
      </div>
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-brand-muted">無痛驗收</p>
        <h3 class="mt-3 font-display text-2xl font-semibold">Sandbox 即試吃</h3>
        <p class="mt-3 text-sm leading-relaxed text-brand-night/80">
          假信箱、假時鐘、persona 切換、state reset —— 驗收員一個人就跑完 UAT。
          不必為了測 SLA 把時間調回上週。
        </p>
      </div>
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-brand-muted">合規即用</p>
        <h3 class="mt-3 font-display text-2xl font-semibold">監控 × 稽核</h3>
        <p class="mt-3 text-sm leading-relaxed text-brand-night/80">
          每一筆動作 append-only 留痕、流程狀態實時可查、外部通知整合監控。
          IT 治理跟法遵不用事後補。
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section id="contact" class="bg-brand-midnight py-20 text-brand-cream">
    <div class="container-narrow">
      <div class="max-w-2xl">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-brand-flame">預約 demo</p>
        <h2 class="mt-3 font-display text-4xl font-semibold leading-tight text-white sm:text-5xl">
          下一頓飯，<br class="hidden sm:block" />
          交給 AI 廚房。
        </h2>
        <p class="mt-4 text-base text-brand-cream/80">
          告訴我們你手上有哪些流程，我們示範一條完整的 demo —— 從備料到上菜，30 分鐘看完。
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href="mailto:hello@flowcook.tw" class="btn-flame">寫信約 demo</a>
          <a href="/use-cases" class="text-sm font-medium text-brand-cream/90 underline-offset-4 hover:underline">
            或先看一下主廚推薦菜單 →
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
