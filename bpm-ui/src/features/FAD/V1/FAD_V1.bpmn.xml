      <bpmndi:BPMNShape id="cf_di" bpmnElement="cf"><dc:Bounds x="590" y="120" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_di" bpmnElement="e"><dc:Bounds x="760" y="142" width="36" height="36" /></bpmndi:BPMNShape>
