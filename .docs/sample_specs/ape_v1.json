{
  "meta": {
    "schemaVersion": "1.0",
    "tenant": "acme",
    "flowName": "預支費用申請",
    "flowCode": "APE",
    "flowVersion": 1,
    "createdAt": "2026-05-11T00:00:00Z",
    "createdBy": "u_demo",
    "language": "zh-TW",
    "notes": "Per workflow.ts APE: employee → manager → finance(confirm) → finance(fin_review) → close. Used for cash advance before incurring expense; reconciled later via separate flow."
  },
  "flow": {
    "nodes": [
      { "id": "start_1", "type": "startEvent", "label": "開始" },
      { "id": "task_apply", "type": "userTask", "label": "員工申請" },
      { "id": "approval_manager", "type": "approval", "label": "主管簽核" },
      { "id": "task_finance_confirm", "type": "userTask", "label": "確認列印" },
      { "id": "task_finance_review", "type": "userTask", "label": "財務審查" },
      { "id": "end_1", "type": "endEvent", "label": "結案" }
    ],
    "edges": [
      { "id": "e1", "source": "start_1", "target": "task_apply" },
      { "id": "e2", "source": "task_apply", "target": "approval_manager" },
      { "id": "e3", "source": "approval_manager", "target": "task_finance_confirm" },
      { "id": "e4", "source": "task_finance_confirm", "target": "task_finance_review" },
      { "id": "e5", "source": "task_finance_review", "target": "end_1" }
    ]
  },
  "userTasks": [
    {
      "id": "task_apply",
      "formCode": "APE_APPLY",
      "fields": [
        { "id": "advance_amount", "label": { "zh-TW": "預支金額", "en": "Advance Amount" }, "type": "number", "required": true, "validator": "value > 0" },
        {
          "id": "currency",
          "label": { "zh-TW": "幣別", "en": "Currency" },
          "type": "select",
          "required": true,
          "options": [
            { "value": "TWD", "label": "TWD" },
            { "value": "USD", "label": "USD" }
          ]
        },
        { "id": "purpose", "label": { "zh-TW": "用途", "en": "Purpose" }, "type": "textarea", "required": true },
        { "id": "expected_spend_date", "label": { "zh-TW": "預計花費日期", "en": "Expected Spend Date" }, "type": "date", "required": true },
        { "id": "expected_settle_date", "label": { "zh-TW": "預計核銷日期", "en": "Expected Settle Date" }, "type": "date", "required": true },
        { "id": "charge_dept", "label": { "zh-TW": "費用部門", "en": "Charge Department" }, "type": "text", "required": true }
      ],
      "permissions": { "submitter": "self", "viewers": ["self", "manager", "role:Finance"] }
    },
    {
      "id": "task_finance_confirm",
      "formCode": "APE_FINANCE_CONFIRM",
      "fields": [
        { "id": "print_no", "label": { "zh-TW": "列印單號", "en": "Print No." }, "type": "text", "required": true },
        { "id": "confirm_note", "label": { "zh-TW": "確認備註", "en": "Note" }, "type": "textarea", "required": false }
      ],
      "permissions": { "submitter": "role:Finance", "viewers": ["role:Finance", "self", "manager"] }
    },
    {
      "id": "task_finance_review",
      "formCode": "APE_FINANCE_REVIEW",
      "fields": [
        { "id": "review_note", "label": { "zh-TW": "審查備註", "en": "Review Note" }, "type": "textarea", "required": false },
        { "id": "disbursed_at", "label": { "zh-TW": "撥款日期", "en": "Disbursed At" }, "type": "date", "required": true }
      ],
      "permissions": { "submitter": "role:Finance", "viewers": ["role:Finance", "self", "manager"] }
    }
  ],
  "decisions": [],
  "approvals": [
    { "id": "approval_manager", "approver": { "type": "expr", "path": "submitter.manager" } }
  ],
  "notifications": [
    {
      "id": "notify_assign",
      "trigger": "on_assign",
      "channel": ["email", "in_app"],
      "recipients": [{ "type": "current_approver" }],
      "template": {
        "subject": { "zh-TW": "【預支費用待簽】{{applicant.name}} - {{advance.amount}} {{advance.currency}}" },
        "body": { "zh-TW": "申請人: {{applicant.name}}\n金額: {{advance.amount}} {{advance.currency}}\n用途: {{advance.purpose}}\n預計花費日: {{advance.spendDate}}\n預計核銷日: {{advance.settleDate}}\n\n請點此核准: {{caseUrl}}" },
        "variables": ["applicant.name", "advance.amount", "advance.currency", "advance.purpose", "advance.spendDate", "advance.settleDate", "caseUrl"]
      }
    },
    {
      "id": "notify_complete",
      "trigger": "on_complete",
      "channel": ["email"],
      "recipients": [{ "type": "submitter" }],
      "template": {
        "subject": { "zh-TW": "您的預支費用申請已完成" },
        "body": { "zh-TW": "您於 {{submitDate}} 申請的 {{advance.amount}} {{advance.currency}} 預支金已撥付，請於 {{advance.settleDate}} 前完成核銷。" },
        "variables": ["submitDate", "advance.amount", "advance.currency", "advance.settleDate"]
      }
    }
  ],
  "sla": {
    "perNode": {
      "approval_manager": { "duration": "8h", "businessHoursOnly": true, "escalation": { "after": "8h", "action": "notify" } },
      "task_finance_confirm": { "duration": "16h", "businessHoursOnly": true },
      "task_finance_review": { "duration": "24h", "businessHoursOnly": true }
    }
  },
  "integrations": {
    "identityProvider": "csv",
    "csvSource": { "url": "s3://bpm-tenants/acme/employees-2026-05-11.csv" },
    "fieldMappings": {
      "employeeId": "empId",
      "displayName": "name",
      "email": "email",
      "reportsTo": "manager",
      "department": "department",
      "title": "title"
    }
  },
  "testCases": [
    {
      "id": "tc_happy_advance",
      "name": "預支 30,000 元出差現金、主管核准",
      "inputs": {
        "advance_amount": 30000,
        "currency": "TWD",
        "purpose": "5/20 客戶拜訪預估費用",
        "expected_spend_date": "2026-05-20",
        "expected_settle_date": "2026-06-15",
        "charge_dept": "TWT.1746G - Elton Yang"
      },
      "expectedTrace": ["start_1", "task_apply", "approval_manager", "task_finance_confirm", "task_finance_review", "end_1"],
      "expectedFinalStatus": "Completed",
      "expectedNotifications": [
        { "trigger": "on_assign", "recipientCount": 1 },
        { "trigger": "on_complete", "recipientCount": 1 }
      ]
    },
    {
      "id": "tc_reject_by_manager",
      "name": "主管退件 → 流程結束於 Errored",
      "inputs": {
        "advance_amount": 5000,
        "currency": "TWD",
        "purpose": "理由不足",
        "expected_spend_date": "2026-05-15",
        "expected_settle_date": "2026-05-30",
        "charge_dept": "TWT.1746G"
      },
      "managerDecision": "reject",
      "expectedTrace": ["start_1", "task_apply", "approval_manager"],
      "expectedFinalStatus": "Errored"
    }
  ]
}
