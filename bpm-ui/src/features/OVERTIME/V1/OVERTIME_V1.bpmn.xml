      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_approval_manager" bpmnElement="approval_manager">
        <dc:Bounds x="430" y="230" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_gateway_approved" bpmnElement="gateway_approved" isMarkerVisible="true">
        <dc:Bounds x="615" y="245" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="600" y="215" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_gateway_hours" bpmnElement="gateway_hours" isMarkerVisible="true">
        <dc:Bounds x="735" y="245" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="710" y="298" width="100" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_approval_hr" bpmnElement="approval_hr">
        <dc:Bounds x="850" y="110" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_gateway_hr_result" bpmnElement="gateway_hr_result" isMarkerVisible="true">
        <dc:Bounds x="1035" y="125" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1020" y="95" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_notify_reject_manager" bpmnElement="notify_reject_manager">
        <dc:Bounds x="580" y="400" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_notify_reject_hr" bpmnElement="notify_reject_hr">
        <dc:Bounds x="1150" y="110" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_notify_approve" bpmnElement="notify_approve">
        <dc:Bounds x="990" y="400" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_end_approved" bpmnElement="end_approved">
        <dc:Bounds x="1192" y="422" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1180" y="465" width="60" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_end_rejected_manager" bpmnElement="end_rejected_manager">
        <dc:Bounds x="622" y="522" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="610" y="565" width="60" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_end_rejected_hr" bpmnElement="end_rejected_hr">
        <dc:Bounds x="1332" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1320" y="175" width="60" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="di_e1" bpmnElement="e1">
