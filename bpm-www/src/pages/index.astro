---
import BaseLayout from '../layouts/BaseLayout.astro'
import KitchenAct from '../components/KitchenAct.astro'
import Showcase from '../components/Showcase.astro'
import Screenshot from '../components/Screenshot.astro'
---
<BaseLayout>
  <!-- Hero — TREND BPM dark navy band (echo bpm-ui top header), 2-col grid -->
  <section class="relative overflow-hidden bg-header text-white">
    <div class="container-wide py-16 lg:py-24">
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-[1fr_1.1fr]">
        <!-- Left: copy -->
        <div class="max-w-xl">
          <span class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-3 py-1 font-mono text-xs uppercase tracking-[0.18em] text-accent">
            <span aria-hidden="true">🍳</span>
            AI 企業流程平台
          </span>
          <h1 class="mt-6 text-5xl font-semibold leading-[1.1] tracking-tight text-white sm:text-6xl">
            把公司的流程，<br class="hidden sm:block" />
            變成能上線的系統。
          </h1>
          <p class="mt-6 text-lg leading-relaxed text-white/85 sm:text-xl">
            描述你的請假、請款、差旅流程，<br class="hidden sm:block" />
            <strong class="text-accent">AI 廚房</strong>幫你設計、<strong class="text-accent">AI 主廚</strong>寫成真實程式，試吃驗收後上線。
          </p>
          <div class="mt-10 flex flex-wrap items-center gap-4">
            <a href="#contact" class="btn-primary">預約 demo</a>
            <a href="/how-it-works" class="btn-ghost border-white/30 bg-white/5 text-white hover:bg-white hover:text-ink">看運作方式 →</a>
          </div>
        </div>

        <!-- Right: real product screenshot in mac-style browser frame -->
        <div class="relative">
          <div class="absolute -inset-4 rounded-2xl bg-gradient-to-tr from-primary/25 via-accent/10 to-transparent blur-2xl"></div>
          <div class="relative overflow-hidden rounded-xl border border-white/15 bg-card shadow-2xl shadow-black/40">
            <div class="flex items-center gap-1.5 border-b border-rule bg-page px-3 py-2">
              <span class="h-2.5 w-2.5 rounded-full bg-red-400"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-yellow-400"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-green-400"></span>
              <span class="ml-3 font-mono text-[10px] text-inkMuted">flowcook · 後台</span>
            </div>
            <img
              src="/screenshots/wizard-hero.png"
              alt="flowcook 後台 — AI 廚房對話式設計流程，搭配 BPMN 流程圖"
              loading="eager"
              class="block w-full"
            />
          </div>
          <p class="mt-3 text-center font-mono text-[10px] uppercase tracking-[0.18em] text-white/55">
            真實後台畫面 — AI 廚房 第 1 步
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Three acts -->
  <section class="bg-page py-20 sm:py-28">
    <div class="container-narrow">
      <div class="mb-14 max-w-3xl">
        <p class="kicker">三步驟，從想法到上線</p>
        <h2 class="mt-3 text-4xl font-semibold leading-tight sm:text-5xl">
          備料（規格），<br class="hidden sm:block" />
          烹調（開發），<br class="hidden sm:block" />
          上菜（驗收、部署）。
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-ink/85">
          中間每一步，都有 <strong class="text-primary">AI</strong> 幫你完成。
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6">
        <KitchenAct
          act="prep"
          icon="🥬"
          english="Prep"
          zh="備料"
          headline="AI 廚房 —— 把流程描述清楚"
          body="從 PDF、流程圖到老闆口述，AI 邊聊邊問細節。十一道工序覆蓋表單、決策、審核、通知、時限、整合，最後產出一份精準到能直接動工的規格。"
          note="沒人需要學 BPMN —— 你只需要會講流程怎麼跑。"
        />
        <KitchenAct
          act="cook"
          icon="🔥"
          english="Cook"
          zh="烹調"
          headline="AI 主廚 —— 寫真實的程式"
          body="規格交給 AI 主廚，他寫真實的 React + .NET，不是低代碼罐頭。每一行都能在 GitHub 上逐行審查，程式是你的，未來自己接手也順手。"
          note="沒有平台綁架。用得開心也行，想換團隊接手也行。"
        />
        <KitchenAct
          act="serve"
          icon="🍽"
          english="Serve"
          zh="上菜"
          headline="試吃驗收 → 正式上線"
          body="假信箱、假時鐘、身分一鍵切換 —— 一個驗收員就能跑完整驗收，完全不影響真實系統。試吃滿意，再推上正式環境。"
          note="上線那一刻，你心裡是踏實的。"
        />
      </div>
    </div>
  </section>

  <!-- Product showcase — real running screens -->
  <section class="bg-card py-20 sm:py-28">
    <div class="container-narrow">
      <div class="mb-16 max-w-3xl">
        <p class="kicker">看看實際產品</p>
        <h2 class="mt-3 text-4xl font-semibold leading-tight sm:text-5xl">
          這就是實際在跑的系統。
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-ink/85">
          員工端的日常簽核、管理端的驗收與治理 —— 下面每一張都是直接從系統截下來的實機畫面。
        </p>
      </div>

      <div class="space-y-24">
        <Showcase
          src="/screenshots/runtime-home.png"
          alt="flowcook 員工端首頁 — 待辦收件匣、近期案件、快速開單"
          label="flowcook · 員工端"
          kicker="員工端"
          title="員工的日常，一個入口搞定"
          body="送單、追蹤、簽核全在同一個收件匣。十幾條流程一鍵開單，待辦、進度、通知集中一處 —— 員工不必記得哪張表在哪個系統。"
          bullets={[
            '統一收件匣 —— 跨流程的待辦集中，不漏簽',
            '即時進度 —— 卡在誰、第幾關，一目了然',
            '中英雙語介面，員工零學習成本',
          ]}
        />
        <Showcase
          reverse
          src="/screenshots/sandbox-console.png"
          alt="flowcook admin Sandbox 主控台 — 攔信、時間快轉、persona 切換"
          label="flowcook · 後台"
          kicker="無痛驗收"
          title="上線前，先在 Sandbox 試吃"
          body="攔信、假時鐘、身分一鍵切換、一鍵清空重跑 —— 一個驗收員就能跑完整驗收，完全不碰真實系統、不會誤寄信、不會誤扣款。"
          bullets={[
            '攔信 —— 對外信件進假信箱，不會真的寄出',
            '時間快轉 —— 測時限到期？秒跳 24 小時看結果',
            '身分切換 —— 不用登入五個帳號跑全程',
          ]}
        />
        <Showcase
          src="/screenshots/doctor.png"
          alt="flowcook admin Doctor — 卡關案件偵測與組織設定健檢"
          label="flowcook · 後台"
          kicker="治理 × 健檢"
          title="流程卡住、設定有洞，系統先幫你抓"
          body="系統健檢主動掃描卡關案件與組織設定問題（離職的簽核人、沒有成員的角色…），並提供一鍵補救入口。IT 治理不必等出事才補。"
          bullets={[
            '卡關偵測 —— 一鍵改派 / 強制結案',
            '組織健檢 —— 抓出沒人在的角色與斷掉的指派',
            '每筆動作逐筆留痕，改不了、刪不掉',
          ]}
        />
      </div>

      <!-- gallery strip -->
      <div class="mt-24 grid grid-cols-1 gap-8 lg:grid-cols-3">
        <Screenshot
          src="/screenshots/flow-form.png"
          alt="flowcook 流程表單 — 上方流程步驟條 + 明細欄位"
          label="flowcook · 員工端"
          caption="表單體驗 — 步驟條 + BPMN"
        />
        <Screenshot
          src="/screenshots/case-detail.png"
          alt="flowcook 案件詳情 — 簽核時序軸與核准 / 退件"
          label="flowcook · 員工端"
          caption="簽核 — 時序軸 + 核准 / 退件"
        />
        <Screenshot
          src="/screenshots/ai-kitchen.png"
          alt="flowcook 後台 AI 廚房 — 已上線的流程清單"
          label="flowcook · 後台"
          caption="AI 廚房 — 流程已上線"
        />
      </div>
    </div>
  </section>

  <!-- Why flowcook -->
  <section class="bg-page py-20 sm:py-28">
    <div class="container-narrow grid grid-cols-1 gap-12 md:grid-cols-3">
      <div>
        <p class="kicker">業界標準</p>
        <h3 class="mt-3 text-2xl font-semibold">不重新發明輪子</h3>
        <p class="mt-3 text-sm leading-relaxed text-ink/80">
          BPMN 2.0 描述流程、CEL 寫條件、OpenAPI 描述整合、Entra ID 對接組織 —— 全是業界開放標準。
          沒有奇怪的私有格式綁架你。
        </p>
      </div>
      <div>
        <p class="kicker">無痛驗收</p>
        <h3 class="mt-3 text-2xl font-semibold">試吃即驗收</h3>
        <p class="mt-3 text-sm leading-relaxed text-ink/80">
          假信箱、假時鐘、身分切換、一鍵重置 —— 驗收員一個人就跑完整套驗收。
          不必為了測時限把時間調回上週。
        </p>
      </div>
      <div>
        <p class="kicker">合規即用</p>
        <h3 class="mt-3 text-2xl font-semibold">監控 × 稽核</h3>
        <p class="mt-3 text-sm leading-relaxed text-ink/80">
          每一筆動作逐筆留痕、流程狀態即時可查、對外通知整合監控。
          IT 治理跟法遵不用事後補。
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section id="contact" class="bg-header py-20 text-white">
    <div class="container-narrow">
      <div class="max-w-2xl">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">預約 demo</p>
        <h2 class="mt-3 text-4xl font-semibold leading-tight text-white sm:text-5xl">
          把第一條流程，<br class="hidden sm:block" />
          交給 flowcook。
        </h2>
        <p class="mt-4 text-base text-white/80">
          告訴我們你手上有哪些流程，我們示範一條完整的 demo —— 從備料到上菜，30 分鐘看完。
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href="mailto:hello@flowcook.tw" class="btn-primary">寫信約 demo</a>
          <a href="/use-cases" class="text-sm font-medium text-white/90 underline-offset-4 hover:underline">
            或先看應用場景 →
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
