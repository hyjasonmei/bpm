        <di:waypoint x="856" y="170" />
        <di:waypoint x="856" y="65" />
        <di:waypoint x="896" y="65" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_dept_gw_di" bpmnElement="e_dept_gw">
        <di:waypoint x="896" y="39" />
        <di:waypoint x="134" y="39" />
        <di:waypoint x="134" y="78" />
        <di:waypoint x="62" y="78" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_gw_dept_approve_di" bpmnElement="e_gw_dept_approve">
        <di:waypoint x="62" y="90" />
        <di:waypoint x="284" y="90" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="174" y="99" width="40" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_gw_dept_reject_di" bpmnElement="e_gw_dept_reject">
        <di:waypoint x="62" y="103" />
        <di:waypoint x="134" y="103" />
