        <dc:Bounds x="516" y="60" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_approval_finance" bpmnElement="approval_finance">
        <dc:Bounds x="516" y="300" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_gateway_join" bpmnElement="gateway_join">
        <dc:Bounds x="686" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_gateway_decision" bpmnElement="gateway_decision" isMarkerVisible="true">
        <dc:Bounds x="796" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="782" y="232" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_approval_legal_mgr" bpmnElement="approval_legal_mgr">
        <dc:Bounds x="906" y="60" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_task_revise" bpmnElement="task_revise">
        <dc:Bounds x="906" y="300" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_end_approved" bpmnElement="end_approved">
        <dc:Bounds x="1086" y="82" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1078" y="125" width="54" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="di_end_cancelled" bpmnElement="end_cancelled">
        <dc:Bounds x="1086" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1074" y="365" width="62" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
