      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5"><di:waypoint x="700" y="160" /><di:waypoint x="760" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4"><di:waypoint x="475" y="200" /><di:waypoint x="475" y="270" /><di:waypoint x="300" y="270" /><di:waypoint x="300" y="200" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
