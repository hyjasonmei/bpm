      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <di:waypoint x="265" y="265" />
        <di:waypoint x="265" y="320" />
        <di:waypoint x="360" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4">
        <di:waypoint x="490" y="160" />
        <di:waypoint x="585" y="160" />
        <di:waypoint x="585" y="215" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5">
        <di:waypoint x="490" y="320" />
        <di:waypoint x="585" y="320" />
        <di:waypoint x="585" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_di" bpmnElement="f6">
        <di:waypoint x="610" y="240" />
