{
  "meta": {
    "schemaVersion": "1.0",
    "tenant": "acme",
    "flowName": "員工費用申請",
    "flowCode": "EXPENSE_EMP",
    "flowVersion": 1,
    "createdAt": "2026-05-11T00:00:00Z",
    "createdBy": "u_demo",
    "language": "zh-TW"
  },
  "flow": {
    "nodes": [
      { "id": "start_1", "type": "startEvent", "label": "開始" },
      { "id": "task_submit", "type": "userTask", "label": "員工提交費用" },
      { "id": "approval_manager", "type": "approval", "label": "主管核准" },
      { "id": "task_finance_settle", "type": "userTask", "label": "財務結算" },
      { "id": "end_1", "type": "endEvent", "label": "完成" }
    ],
    "edges": [
      { "id": "e1", "source": "start_1", "target": "task_submit" },
      { "id": "e2", "source": "task_submit", "target": "approval_manager" },
      { "id": "e3", "source": "approval_manager", "target": "task_finance_settle" },
      { "id": "e4", "source": "task_finance_settle", "target": "end_1" }
    ]
  },
  "userTasks": [
    {
      "id": "task_submit",
      "formCode": "EXPENSE_EMP_SUBMIT",
      "fields": [
        { "id": "purpose", "label": { "zh-TW": "用途", "en": "Purpose" }, "type": "textarea", "required": true },
        { "id": "expense_items", "label": { "zh-TW": "費用項目" }, "type": "textarea", "required": true, "hint": { "zh-TW": "後台展開為 [{ category, amount }]" } },
        { "id": "total_amount", "label": { "zh-TW": "總金額", "en": "Total" }, "type": "derived", "required": false, "derivedFrom": "sum(expense_items.amount)" },
        { "id": "receipts", "label": { "zh-TW": "收據" }, "type": "file", "required": true }
      ],
      "permissions": { "submitter": "self", "viewers": ["self", "manager", "role:Finance"] }
    },
    {
      "id": "task_finance_settle",
      "formCode": "EXPENSE_EMP_SETTLE",
      "fields": [
        { "id": "settle_note", "label": { "zh-TW": "結算備註" }, "type": "textarea", "required": false },
        { "id": "paid_at", "label": { "zh-TW": "撥款日期" }, "type": "date", "required": true }
      ],
      "permissions": { "submitter": "role:Finance", "viewers": ["role:Finance", "self"] }
    }
  ],
  "decisions": [],
  "approvals": [
    { "id": "approval_manager", "approver": { "type": "expr", "path": "submitter.manager" } }
  ],
  "notifications": [
    {
      "id": "notify_assign",
      "trigger": "on_assign",
      "channel": ["email", "in_app"],
      "recipients": [{ "type": "current_approver" }],
      "template": {
        "subject": { "zh-TW": "【費用待簽】{{applicant.name}} - {{expense.total}} 元" },
        "body": { "zh-TW": "申請人: {{applicant.name}}\n用途: {{expense.purpose}}\n總金額: {{expense.total}}\n\n請核准: {{caseUrl}}" },
        "variables": ["applicant.name", "expense.purpose", "expense.total", "caseUrl"]
      }
    }
  ],
  "sla": {
    "perNode": {
      "approval_manager": { "duration": "8h", "businessHoursOnly": true, "escalation": { "after": "8h", "action": "notify" } },
      "task_finance_settle": { "duration": "24h", "businessHoursOnly": true }
    }
  },
  "integrations": {
    "identityProvider": "csv",
    "csvSource": { "url": "s3://bpm-tenants/acme/employees-2026-05-11.csv" },
    "fieldMappings": {
      "employeeId": "empId",
      "displayName": "name",
      "email": "email",
      "reportsTo": "manager",
      "department": "department",
      "title": "title"
    }
  },
  "testCases": [
    {
      "id": "tc_1",
      "name": "三筆費用合計 12,500 元",
      "inputs": {
        "purpose": "客戶拜訪零星支出",
        "expense_items": [
          { "category": "車資", "amount": 2500 },
          { "category": "餐費", "amount": 4000 },
          { "category": "住宿", "amount": 6000 }
        ],
        "receipts": "receipts.zip"
      },
      "expectedPath": ["start_1", "task_submit", "approval_manager", "task_finance_settle", "end_1"],
      "expectedApprovers": [{ "nodeId": "approval_manager", "userIds": ["u_wang_manager"] }]
    }
  ]
}
