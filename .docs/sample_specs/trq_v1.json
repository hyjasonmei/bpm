{
  "meta": {
    "schemaVersion": "1.0",
    "tenant": "acme",
    "flowName": "差旅申請",
    "flowCode": "TRQ",
    "flowVersion": 1,
    "createdAt": "2026-05-11T00:00:00Z",
    "createdBy": "u_demo",
    "language": "zh-TW",
    "notes": "Per workflow.ts TRQ: employee → manager → admin(notify) → close. Admin step is travel-coordination notification (booking handled outside the system)."
  },
  "flow": {
    "nodes": [
      { "id": "start_1", "type": "startEvent", "label": "開始" },
      { "id": "task_apply", "type": "userTask", "label": "員工申請" },
      { "id": "approval_manager", "type": "approval", "label": "主管簽核" },
      { "id": "task_admin_notify", "type": "userTask", "label": "通知行政" },
      { "id": "end_1", "type": "endEvent", "label": "結案" }
    ],
    "edges": [
      { "id": "e1", "source": "start_1", "target": "task_apply" },
      { "id": "e2", "source": "task_apply", "target": "approval_manager" },
      { "id": "e3", "source": "approval_manager", "target": "task_admin_notify" },
      { "id": "e4", "source": "task_admin_notify", "target": "end_1" }
    ]
  },
  "userTasks": [
    {
      "id": "task_apply",
      "formCode": "TRQ_APPLY",
      "fields": [
        { "id": "destination", "label": { "zh-TW": "出差地點", "en": "Destination" }, "type": "text", "required": true },
        { "id": "purpose", "label": { "zh-TW": "出差目的", "en": "Purpose" }, "type": "textarea", "required": true },
        { "id": "travel_dates", "label": { "zh-TW": "預計起訖時間", "en": "Travel Dates" }, "type": "daterange", "required": true },
        {
          "id": "transport",
          "label": { "zh-TW": "交通工具", "en": "Transport" },
          "type": "select",
          "required": true,
          "options": [
            { "value": "hsr", "label": "高鐵" },
            { "value": "flight", "label": "飛機" },
            { "value": "self_drive", "label": "自駕" },
            { "value": "other", "label": "其他" }
          ]
        },
        { "id": "estimated_amount", "label": { "zh-TW": "預估金額", "en": "Estimated Amount" }, "type": "number", "required": false, "validator": "value >= 0" },
        { "id": "needs_pickup", "label": { "zh-TW": "需要接送", "en": "Pickup Required" }, "type": "select", "required": false,
          "options": [
            { "value": "yes", "label": "是" },
            { "value": "no", "label": "否" }
          ] },
        { "id": "pickup_address", "label": { "zh-TW": "接送地址", "en": "Pickup Address" }, "type": "text", "required": false, "conditional": "needs_pickup == 'yes'" }
      ],
      "permissions": { "submitter": "self", "viewers": ["self", "manager", "role:Admin"] }
    },
    {
      "id": "task_admin_notify",
      "formCode": "TRQ_ADMIN_NOTIFY",
      "fields": [
        { "id": "booking_status", "label": { "zh-TW": "訂位狀態", "en": "Booking Status" }, "type": "select", "required": true,
          "options": [
            { "value": "booked", "label": "已訂位" },
            { "value": "self_arrange", "label": "自行安排" },
            { "value": "n_a", "label": "不需協助" }
          ] },
        { "id": "admin_note", "label": { "zh-TW": "行政備註", "en": "Admin Note" }, "type": "textarea", "required": false }
      ],
      "permissions": { "submitter": "role:Admin", "viewers": ["role:Admin", "self", "manager"] }
    }
  ],
  "decisions": [],
  "approvals": [
    { "id": "approval_manager", "approver": { "type": "expr", "path": "submitter.manager" } }
  ],
  "notifications": [
    {
      "id": "notify_assign",
      "trigger": "on_assign",
      "channel": ["email", "in_app"],
      "recipients": [{ "type": "current_approver" }],
      "template": {
        "subject": { "zh-TW": "【差旅申請待簽】{{applicant.name}} - {{trip.destination}}" },
        "body": { "zh-TW": "申請人: {{applicant.name}}\n地點: {{trip.destination}}\n目的: {{trip.purpose}}\n\n請點此核准: {{caseUrl}}" },
        "variables": ["applicant.name", "trip.destination", "trip.purpose", "caseUrl"]
      }
    },
    {
      "id": "notify_complete",
      "trigger": "on_complete",
      "channel": ["email"],
      "recipients": [{ "type": "submitter" }],
      "template": {
        "subject": { "zh-TW": "您的差旅申請已完成" },
        "body": { "zh-TW": "您的 {{trip.destination}} 差旅申請已核准並通知行政協助。" },
        "variables": ["trip.destination"]
      }
    }
  ],
  "sla": {
    "perNode": {
      "approval_manager": { "duration": "16h", "businessHoursOnly": true, "escalation": { "after": "16h", "action": "notify" } },
      "task_admin_notify": { "duration": "24h", "businessHoursOnly": true }
    }
  },
  "integrations": {
    "identityProvider": "csv",
    "csvSource": { "url": "s3://bpm-tenants/acme/employees-2026-05-11.csv" },
    "fieldMappings": {
      "employeeId": "empId",
      "displayName": "name",
      "email": "email",
      "reportsTo": "manager",
      "department": "department",
      "title": "title"
    }
  },
  "testCases": [
    {
      "id": "tc_happy_taipei_to_dubai",
      "name": "台北 → 杜拜出差、主管核准 → 行政訂位",
      "inputs": {
        "destination": "Dubai, UAE",
        "purpose": "DMCC 2026 RSM auditing",
        "travel_dates": { "start": "2026-06-15", "end": "2026-06-22" },
        "transport": "flight",
        "estimated_amount": 80000,
        "needs_pickup": "yes",
        "pickup_address": "台北市大安區"
      },
      "expectedTrace": ["start_1", "task_apply", "approval_manager", "task_admin_notify", "end_1"],
      "expectedFinalStatus": "Completed",
      "expectedNotifications": [
        { "trigger": "on_assign", "recipientCount": 1 },
        { "trigger": "on_complete", "recipientCount": 1 }
      ]
    },
    {
      "id": "tc_reject_by_manager",
      "name": "主管退件 → 流程結束於 Errored",
      "inputs": {
        "destination": "Tokyo",
        "purpose": "non-essential",
        "travel_dates": { "start": "2026-06-01", "end": "2026-06-03" },
        "transport": "flight"
      },
      "managerDecision": "reject",
      "expectedTrace": ["start_1", "task_apply", "approval_manager"],
      "expectedFinalStatus": "Errored"
    }
  ]
}
