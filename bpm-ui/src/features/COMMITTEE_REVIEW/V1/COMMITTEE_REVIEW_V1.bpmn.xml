                  targetNamespace="http://flowcook.ai/bpmn/COMMITTEE_REVIEW/V1">
  <bpmn:process id="COMMITTEE_REVIEW_V1" isExecutable="false">
    <bpmn:startEvent id="start_1" name="開始">
      <bpmn:outgoing>e1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="task_apply" name="申請人填寫審議案">
      <bpmn:incoming>e1</bpmn:incoming>
      <bpmn:outgoing>e2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="gateway_fork" name="並行送審（Fork）">
      <bpmn:incoming>e2</bpmn:incoming>
      <bpmn:incoming>e12</bpmn:incoming>
      <bpmn:outgoing>e3</bpmn:outgoing>
      <bpmn:outgoing>e4</bpmn:outgoing>
      <bpmn:outgoing>e5</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="approval_finance" name="財務委員審議">
      <bpmn:incoming>e3</bpmn:incoming>
      <bpmn:outgoing>e6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="approval_procurement" name="採購委員審議">
      <bpmn:incoming>e4</bpmn:incoming>
      <bpmn:outgoing>e7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="approval_it" name="資訊委員審議">
      <bpmn:incoming>e5</bpmn:incoming>
      <bpmn:outgoing>e8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gateway_threshold" name="門檻判斷（2/3）">
      <bpmn:incoming>e6</bpmn:incoming>
      <bpmn:incoming>e7</bpmn:incoming>
      <bpmn:incoming>e8</bpmn:incoming>
      <bpmn:outgoing>e9</bpmn:outgoing>
      <bpmn:outgoing>e10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="notify_return" name="通知申請人案件退回">
      <bpmn:incoming>e9</bpmn:incoming>
      <bpmn:outgoing>e11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="task_revise" name="申請人修改後重新送審">
      <bpmn:incoming>e11</bpmn:incoming>
      <bpmn:outgoing>e12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="approval_ceo" name="執行長最終裁決">
      <bpmn:incoming>e10</bpmn:incoming>
      <bpmn:outgoing>e13</bpmn:outgoing>
      <bpmn:outgoing>e14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="notify_approved" name="通知申請人案件核定">
      <bpmn:incoming>e13</bpmn:incoming>
      <bpmn:outgoing>e15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="notify_rejected" name="通知申請人案件否決（終局）">
      <bpmn:incoming>e14</bpmn:incoming>
      <bpmn:outgoing>e16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end_approved" name="結案（核定）">
      <bpmn:incoming>e15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_rejected" name="結案（否決終局）">
      <bpmn:incoming>e16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="e1" sourceRef="start_1" targetRef="task_apply" />
    <bpmn:sequenceFlow id="e2" sourceRef="task_apply" targetRef="gateway_fork" />
    <bpmn:sequenceFlow id="e3" name="送財務委員" sourceRef="gateway_fork" targetRef="approval_finance" />
    <bpmn:sequenceFlow id="e4" name="送採購委員" sourceRef="gateway_fork" targetRef="approval_procurement" />
    <bpmn:sequenceFlow id="e5" name="送資訊委員" sourceRef="gateway_fork" targetRef="approval_it" />
    <bpmn:sequenceFlow id="e6" sourceRef="approval_finance" targetRef="gateway_threshold" />
    <bpmn:sequenceFlow id="e7" sourceRef="approval_procurement" targetRef="gateway_threshold" />
    <bpmn:sequenceFlow id="e8" sourceRef="approval_it" targetRef="gateway_threshold" />
    <bpmn:sequenceFlow id="e9" name="任一退回" sourceRef="gateway_threshold" targetRef="notify_return" />
    <bpmn:sequenceFlow id="e10" name="≥2位核准" sourceRef="gateway_threshold" targetRef="approval_ceo" />
    <bpmn:sequenceFlow id="e11" sourceRef="notify_return" targetRef="task_revise" />
    <bpmn:sequenceFlow id="e12" name="重新送審" sourceRef="task_revise" targetRef="gateway_fork" />
    <bpmn:sequenceFlow id="e13" name="核定" sourceRef="approval_ceo" targetRef="notify_approved" />
    <bpmn:sequenceFlow id="e14" name="否決" sourceRef="approval_ceo" targetRef="notify_rejected" />
    <bpmn:sequenceFlow id="e15" sourceRef="notify_approved" targetRef="end_approved" />
    <bpmn:sequenceFlow id="e16" sourceRef="notify_rejected" targetRef="end_rejected" />
  </bpmn:process>
