---
import BaseLayout from '../layouts/BaseLayout.astro'
---
<BaseLayout title="關於 — flowcook">
  <section class="bg-header py-16 text-white sm:py-24">
    <div class="container-narrow max-w-3xl">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">About</p>
      <h1 class="mt-3 text-5xl font-semibold leading-tight text-white sm:text-6xl">關於 flowcook</h1>
      <p class="mt-6 text-lg leading-relaxed text-white/85">
        我們從前公司帶回十幾個真實流程當原料 ——
        想做一個中小企業真的用得起來的流程平台。
      </p>
    </div>
  </section>
</BaseLayout>
