      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_e2" bpmnElement="e2">
        <di:waypoint x="370" y="270" /><di:waypoint x="430" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_e3" bpmnElement="e3">
        <di:waypoint x="550" y="270" /><di:waypoint x="615" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="di_e4" bpmnElement="e4">
