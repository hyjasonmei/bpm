        <di:waypoint x="726" y="170" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="314" y="179" width="40" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_finance_gw_di" bpmnElement="e_finance_gw">
        <di:waypoint x="384" y="90" />
        <di:waypoint x="454" y="90" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_gw_finance_approve_di" bpmnElement="e_gw_finance_approve">
        <di:waypoint x="504" y="82" />
