---
import BaseLayout from '../layouts/BaseLayout.astro'
---
<BaseLayout title="點餐方式 — flowcook">
  <section class="bg-gradient-to-b from-brand-cream to-brand-plate/40 py-16 sm:py-24">
    <div class="container-narrow max-w-3xl">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-brand-muted">Pricing</p>
      <h1 class="mt-3 font-display text-5xl font-semibold leading-tight sm:text-6xl">點餐方式</h1>
      <p class="mt-6 text-lg leading-relaxed text-brand-night/85">
        導入費 + 年費 + 顧問點數 —— 細節跟客戶聊完再開菜單。
      </p>
      <p class="mt-3 text-sm text-brand-muted italic">TODO: 等商業模式細節定下來再寫。先 placeholder。</p>
      <a href="mailto:hello@flowcook.tw" class="btn-flame mt-8">直接寫信報價</a>
    </div>
  </section>
</BaseLayout>
