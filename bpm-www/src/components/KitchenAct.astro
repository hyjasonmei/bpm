---
interface Props {
  act: 'prep' | 'cook' | 'serve'
  icon: string
  english: string
  zh: string
  headline: string
  body: string
  note?: string
}

const { act, icon, english, zh, headline, body, note } = Astro.props

const tone = {
  prep:  { bar: 'bg-emerald-500',   chipBg: 'bg-emerald-500/10',  chipText: 'text-emerald-700' },
  cook:  { bar: 'bg-brand-flame',   chipBg: 'bg-brand-flame/10',  chipText: 'text-brand-flame' },
  serve: { bar: 'bg-amber-500',     chipBg: 'bg-amber-500/10',    chipText: 'text-amber-700' },
}[act]
---
<article class="relative grid grid-cols-1 gap-6 rounded-2xl border border-brand-rule/70 bg-white/70 p-8 md:grid-cols-[80px_1fr]">
  <div class="flex flex-col items-start gap-2">
    <div class={`flex h-14 w-14 items-center justify-center rounded-full text-2xl ${tone.chipBg}`}>
      <span aria-hidden="true">{icon}</span>
    </div>
    <span class={`mt-1 font-mono text-[10px] uppercase tracking-[0.18em] ${tone.chipText}`}>
      {english}
    </span>
    <span class="font-display text-sm text-brand-muted">{zh}</span>
  </div>
  <div>
    <h3 class="font-display text-2xl font-semibold leading-tight md:text-3xl">{headline}</h3>
    <p class="mt-3 text-base leading-relaxed text-brand-night/85">{body}</p>
    {note && (
      <p class="mt-3 text-sm text-brand-muted italic">{note}</p>
    )}
  </div>
  <div class={`absolute left-0 top-0 h-full w-1 rounded-l-2xl ${tone.bar}`}></div>
</article>
