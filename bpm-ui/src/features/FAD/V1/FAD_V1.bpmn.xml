    </bpmn:userTask>
    <bpmn:userTask id="cf" name="領收確認 Confirmed">
      <bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e" name="處份 Disposal"><bpmn:incoming>f5</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="s" targetRef="dr" />
    <bpmn:sequenceFlow id="f2" sourceRef="dr" targetRef="ap" />
    <bpmn:sequenceFlow id="f3" sourceRef="ap" targetRef="cf" name="Pass" />
    <bpmn:sequenceFlow id="f4" sourceRef="ap" targetRef="dr" name="Reject" />
    <bpmn:sequenceFlow id="f5" sourceRef="cf" targetRef="e" />
  </bpmn:process>
