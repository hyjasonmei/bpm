<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="PURCHASE_REQUEST_def"
                  targetNamespace="https://bpm.acme.example">
  <bpmn:process id="PURCHASE_REQUEST" isExecutable="true">
    <bpmn:startEvent id="start_1" name="開始">
      <bpmn:outgoing>e_start_apply</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="task_apply" name="填寫採購申請">
      <bpmn:incoming>e_start_apply</bpmn:incoming>
      <bpmn:incoming>e_gw_dept_reject</bpmn:incoming>
      <bpmn:incoming>e_gw_finance_reject</bpmn:incoming>
      <bpmn:outgoing>e_apply_dept</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="approval_dept_head" name="部門主管審核">
      <bpmn:incoming>e_apply_dept</bpmn:incoming>
      <bpmn:outgoing>e_dept_gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gateway_dept" name="主管審核結果">
      <bpmn:incoming>e_dept_gw</bpmn:incoming>
      <bpmn:outgoing>e_gw_dept_approve</bpmn:outgoing>
      <bpmn:outgoing>e_gw_dept_reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="approval_finance" name="財務審核">
      <bpmn:incoming>e_gw_dept_approve</bpmn:incoming>
      <bpmn:outgoing>e_finance_gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gateway_finance" name="財務審核結果">
      <bpmn:incoming>e_finance_gw</bpmn:incoming>
      <bpmn:outgoing>e_gw_finance_approve</bpmn:outgoing>
      <bpmn:outgoing>e_gw_finance_reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_1" name="結束">
      <bpmn:incoming>e_gw_finance_approve</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="e_start_apply" sourceRef="start_1" targetRef="task_apply">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="e_apply_dept" sourceRef="task_apply" targetRef="approval_dept_head">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="e_dept_gw" sourceRef="approval_dept_head" targetRef="gateway_dept">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="e_gw_dept_approve" sourceRef="gateway_dept" targetRef="approval_finance" name="核准">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approved == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="e_gw_dept_reject" sourceRef="gateway_dept" targetRef="task_apply" name="退回">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approved == false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="e_finance_gw" sourceRef="approval_finance" targetRef="gateway_finance">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="e_gw_finance_approve" sourceRef="gateway_finance" targetRef="end_1" name="核准">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approved == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="e_gw_finance_reject" sourceRef="gateway_finance" targetRef="task_apply" name="退回">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approved == false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagram_1">
    <bpmndi:BPMNPlane id="plane_1" bpmnElement="PURCHASE_REQUEST">
      <bpmndi:BPMNShape id="start_1_di" bpmnElement="start_1">
        <dc:Bounds x="620" y="181" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_apply_di" bpmnElement="task_apply">
        <dc:Bounds x="726" y="130" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="approval_dept_head_di" bpmnElement="approval_dept_head">
        <dc:Bounds x="896" y="12" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_dept_di" bpmnElement="gateway_dept" isMarkerVisible="true">
