<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="LEAVE_def"
                  targetNamespace="https://bpm.acme.example">
  <bpmn:process id="LEAVE" isExecutable="true">
    <bpmn:startEvent id="start_1" name="開始">
      <bpmn:outgoing>e1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="task_apply" name="員工申請">
      <bpmn:incoming>e1</bpmn:incoming>
      <bpmn:outgoing>e2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="approval_manager" name="主管核准">
      <bpmn:incoming>e2</bpmn:incoming>
      <bpmn:outgoing>e3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gateway_days" name="超過 7 天？">
      <bpmn:incoming>e3</bpmn:incoming>
      <bpmn:outgoing>e4</bpmn:outgoing>
      <bpmn:outgoing>e5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="approval_vp" name="CEO核准">
      <bpmn:incoming>e4</bpmn:incoming>
      <bpmn:outgoing>e6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_hr_archive" name="HR 備案">
      <bpmn:incoming>e5</bpmn:incoming>
      <bpmn:incoming>e6</bpmn:incoming>
      <bpmn:outgoing>e7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="end_1" name="完成">
      <bpmn:incoming>e7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="e1" sourceRef="start_1" targetRef="task_apply">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="e2" sourceRef="task_apply" targetRef="approval_manager">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="e3" sourceRef="approval_manager" targetRef="gateway_days">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="e4" sourceRef="gateway_days" targetRef="approval_vp">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">days &gt;= 7</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="e5" sourceRef="gateway_days" targetRef="task_hr_archive">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">days &lt; 7</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="e6" sourceRef="approval_vp" targetRef="task_hr_archive">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="e7" sourceRef="task_hr_archive" targetRef="end_1">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagram_1">
    <bpmndi:BPMNPlane id="plane_1" bpmnElement="LEAVE">
      <bpmndi:BPMNShape id="start_1_di" bpmnElement="start_1">
        <dc:Bounds x="12" y="76" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_apply_di" bpmnElement="task_apply">
        <dc:Bounds x="118" y="54" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="approval_manager_di" bpmnElement="approval_manager">
        <dc:Bounds x="288" y="54" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_days_di" bpmnElement="gateway_days" isMarkerVisible="true">
        <dc:Bounds x="458" y="69" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="458" y="69" width="85" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="approval_vp_di" bpmnElement="approval_vp">
        <dc:Bounds x="613" y="12" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_hr_archive_di" bpmnElement="task_hr_archive">
        <dc:Bounds x="783" y="49" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_1_di" bpmnElement="end_1">
        <dc:Bounds x="953" y="71" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="e1_di" bpmnElement="e1">
        <di:waypoint x="48" y="94" />
        <di:waypoint x="118" y="94" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e2_di" bpmnElement="e2">
        <di:waypoint x="218" y="94" />
        <di:waypoint x="288" y="94" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e3_di" bpmnElement="e3">
        <di:waypoint x="388" y="94" />
        <di:waypoint x="458" y="94" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e4_di" bpmnElement="e4">
        <di:waypoint x="508" y="86" />
        <di:waypoint x="573" y="86" />
        <di:waypoint x="573" y="52" />
        <di:waypoint x="613" y="52" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e5_di" bpmnElement="e5">
        <di:waypoint x="508" y="102" />
        <di:waypoint x="783" y="102" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e6_di" bpmnElement="e6">
        <di:waypoint x="713" y="52" />
        <di:waypoint x="743" y="52" />
        <di:waypoint x="743" y="76" />
        <di:waypoint x="783" y="76" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e7_di" bpmnElement="e7">
        <di:waypoint x="883" y="89" />
        <di:waypoint x="953" y="89" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>