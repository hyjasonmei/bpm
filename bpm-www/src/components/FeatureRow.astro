---
interface Props {
  icon: string
  name: string
  desc: string
}
const { icon, name, desc } = Astro.props
---
<div class="flex gap-4 rounded-xl border border-brand-rule/70 bg-white p-5">
  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-flame/10 text-xl" aria-hidden="true">{icon}</span>
  <div>
    <h3 class="font-display text-lg font-semibold text-brand-midnight">{name}</h3>
    <p class="mt-1 text-sm leading-relaxed text-brand-night/80">{desc}</p>
  </div>
</div>
