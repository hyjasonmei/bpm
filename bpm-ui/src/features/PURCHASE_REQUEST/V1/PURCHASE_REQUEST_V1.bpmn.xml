      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_finance_di" bpmnElement="gateway_finance" isMarkerVisible="true">
        <dc:Bounds x="454" y="65" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="454" y="65" width="92" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_1_di" bpmnElement="end_1">
        <dc:Bounds x="726" y="54" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="e_start_apply_di" bpmnElement="e_start_apply">
        <di:waypoint x="656" y="199" />
        <di:waypoint x="686" y="199" />
        <di:waypoint x="686" y="190" />
        <di:waypoint x="726" y="190" />
      </bpmndi:BPMNEdge>
