<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.7" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bpm.Admin.Application\Bpm.Admin.Application.csproj" />
    <ProjectReference Include="..\Bpm.Admin.Persistence\Bpm.Admin.Persistence.csproj" />
  </ItemGroup>

  <!--
    Ship the canonical per-flow BPMN diagrams into the build/publish output so
    register-shipped (and Reset, which re-registers) can persist Flow.BpmnXml on
    a DEPLOYED admin-svc that has no repo source tree. FlowLifecycleService.
    TryReadBundleBpmn reads <BaseDirectory>/bpm-ui/src/features/<CODE>/V1/
    <CODE>_V1.bpmn.xml; the Link preserves that exact layout next to the binary.
    Without this, the AI-Kitchen "BPMN 預覽" tab is dead for shipped flows on
    Azure (no source tree → BpmnXml = null).
  -->
  <ItemGroup>
    <Content Include="..\..\..\bpm-ui\src\features\**\*.bpmn.xml"
             Link="bpm-ui\src\features\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
