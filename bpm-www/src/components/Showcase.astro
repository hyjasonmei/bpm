---
// Image + copy row. Alternates side via `reverse`.
import Screenshot from './Screenshot.astro'
interface Props {
  src: string
  alt: string
  label?: string
  caption?: string
  kicker: string
  title: string
  body: string
  bullets?: string[]
  reverse?: boolean
}
const { src, alt, label, caption, kicker, title, body, bullets = [], reverse = false } = Astro.props
---
<div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-2">
  <div class={reverse ? 'lg:order-2' : ''}>
    <p class="kicker">{kicker}</p>
    <h3 class="mt-3 text-3xl font-semibold leading-tight sm:text-4xl">{title}</h3>
    <p class="mt-4 text-base leading-relaxed text-ink/80">{body}</p>
    {bullets.length > 0 && (
      <ul class="mt-6 space-y-2.5">
        {bullets.map((b) => (
          <li class="flex items-start gap-2.5 text-sm text-ink/75">
            <span class="mt-0.5 text-primary" aria-hidden="true">▸</span>
            <span>{b}</span>
          </li>
        ))}
      </ul>
    )}
  </div>
  <div class={reverse ? 'lg:order-1' : ''}>
    <Screenshot src={src} alt={alt} label={label} caption={caption} />
  </div>
</div>
