---
const navItems = [
  { href: '/how-it-works',  label: '運作方式' },
  { href: '/use-cases',     label: '應用場景' },
  { href: '/features',      label: '功能' },
  { href: '/why-flowcook',  label: '為什麼選我們' },
  { href: '/pricing',       label: '方案與定價' },
  { href: '/about',         label: '關於' },
]

const currentPath = Astro.url.pathname
---
<header class="sticky top-0 z-30 border-b border-header2 bg-header text-white">
  <div class="container-wide flex h-16 items-center justify-between">
    <a href="/" class="flex items-baseline gap-2">
      <span class="text-xl font-semibold tracking-tight text-white">flowcook</span>
      <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-white/55">企業流程平台</span>
    </a>

    <nav class="hidden items-center gap-7 md:flex">
      {navItems.map(item => (
        <a
          href={item.href}
          class:list={[
            'text-sm font-medium transition-colors',
            currentPath.startsWith(item.href)
              ? 'text-accent'
              : 'text-white/80 hover:text-white',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <a href="/#contact" class="btn-primary text-xs">預約 demo</a>
  </div>
</header>
