                  id="def_CONTRACT_REVIEW" targetNamespace="http://flowcook/CONTRACT_REVIEW">
  <bpmn:process id="CONTRACT_REVIEW" isExecutable="true">
    <bpmn:startEvent id="s" name="送出合約">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="gw_review" name="並簽">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="task_legal" name="法務審查 Legal">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_finance" name="財務審查 Finance">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="gw_join" name="會合">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="e" name="完成">
      <bpmn:incoming>f6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="s" targetRef="gw_review" />
    <bpmn:sequenceFlow id="f2" sourceRef="gw_review" targetRef="task_legal" />
    <bpmn:sequenceFlow id="f3" sourceRef="gw_review" targetRef="task_finance" />
    <bpmn:sequenceFlow id="f4" sourceRef="task_legal" targetRef="gw_join" />
    <bpmn:sequenceFlow id="f5" sourceRef="task_finance" targetRef="gw_join" />
    <bpmn:sequenceFlow id="f6" sourceRef="gw_join" targetRef="e" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="CONTRACT_REVIEW">
      <bpmndi:BPMNShape id="s_di" bpmnElement="s">
        <dc:Bounds x="150" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_review_di" bpmnElement="gw_review">
        <dc:Bounds x="240" y="215" width="50" height="50" />
