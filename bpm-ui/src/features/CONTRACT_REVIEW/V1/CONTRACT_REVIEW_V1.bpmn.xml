<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="CONTRACT_REVIEW_V1_defs"
                  targetNamespace="http://flowcook.ai/bpmn/CONTRACT_REVIEW/V1">
  <bpmn:process id="CONTRACT_REVIEW_V1" isExecutable="false">
    <bpmn:startEvent id="start_1" name="送審開始">
      <bpmn:outgoing>e1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="task_apply" name="填寫合約送審表單（含上傳草稿）">
      <bpmn:incoming>e1</bpmn:incoming>
      <bpmn:outgoing>e2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="gateway_fork" name="並行送審">
      <bpmn:incoming>e2</bpmn:incoming>
      <bpmn:incoming>e10</bpmn:incoming>
      <bpmn:outgoing>e3</bpmn:outgoing>
      <bpmn:outgoing>e4</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="approval_legal" name="法務審查">
      <bpmn:incoming>e3</bpmn:incoming>
      <bpmn:outgoing>e5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="approval_finance" name="財務審查">
      <bpmn:incoming>e4</bpmn:incoming>
      <bpmn:outgoing>e6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="gateway_join" name="審查結果匯合">
      <bpmn:incoming>e5</bpmn:incoming>
      <bpmn:incoming>e6</bpmn:incoming>
      <bpmn:outgoing>e7</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="gateway_decision" name="是否全部核准？">
      <bpmn:incoming>e7</bpmn:incoming>
      <bpmn:outgoing>e8</bpmn:outgoing>
      <bpmn:outgoing>e9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="approval_legal_mgr" name="法務主管定案歸檔">
      <bpmn:incoming>e8</bpmn:incoming>
      <bpmn:outgoing>e12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_revise" name="申請人修改後重新送審">
      <bpmn:incoming>e9</bpmn:incoming>
      <bpmn:outgoing>e10</bpmn:outgoing>
      <bpmn:outgoing>e11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="end_approved" name="合約審查完成">
      <bpmn:incoming>e12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_cancelled" name="申請人放棄送審">
      <bpmn:incoming>e11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="e1" sourceRef="start_1" targetRef="task_apply" />
    <bpmn:sequenceFlow id="e2" sourceRef="task_apply" targetRef="gateway_fork" />
    <bpmn:sequenceFlow id="e3" name="法務" sourceRef="gateway_fork" targetRef="approval_legal" />
    <bpmn:sequenceFlow id="e4" name="財務" sourceRef="gateway_fork" targetRef="approval_finance" />
    <bpmn:sequenceFlow id="e5" sourceRef="approval_legal" targetRef="gateway_join" />
    <bpmn:sequenceFlow id="e6" sourceRef="approval_finance" targetRef="gateway_join" />
    <bpmn:sequenceFlow id="e7" sourceRef="gateway_join" targetRef="gateway_decision" />
    <bpmn:sequenceFlow id="e8" name="全部核准" sourceRef="gateway_decision" targetRef="approval_legal_mgr" />
    <bpmn:sequenceFlow id="e9" name="任一退回" sourceRef="gateway_decision" targetRef="task_revise" />
    <bpmn:sequenceFlow id="e10" name="重新送審" sourceRef="task_revise" targetRef="gateway_fork" />
    <bpmn:sequenceFlow id="e11" name="放棄送審" sourceRef="task_revise" targetRef="end_cancelled" />
    <bpmn:sequenceFlow id="e12" sourceRef="approval_legal_mgr" targetRef="end_approved" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="CONTRACT_REVIEW_V1">
      <bpmndi:BPMNShape id="di_start_1" bpmnElement="start_1">
        <dc:Bounds x="150" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="145" y="225" width="50" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
