---
// Real product screenshot in a mac-style browser frame (echoes the hero treatment).
interface Props {
  src: string
  alt: string
  label?: string
  caption?: string
  eager?: boolean
}
const { src, alt, label = 'flowcook', caption, eager = false } = Astro.props
---
<figure class="relative">
  <div class="absolute -inset-4 rounded-2xl bg-gradient-to-tr from-primary/20 via-accent/10 to-transparent blur-2xl"></div>
  <div class="relative overflow-hidden rounded-xl border border-rule bg-card shadow-2xl shadow-black/20">
    <div class="flex items-center gap-1.5 border-b border-rule bg-page px-3 py-2">
      <span class="h-2.5 w-2.5 rounded-full bg-red-400"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-yellow-400"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-green-400"></span>
      <span class="ml-3 font-mono text-[10px] text-inkMuted">{label}</span>
    </div>
    <img src={src} alt={alt} loading={eager ? 'eager' : 'lazy'} class="block w-full" data-zoom data-zoom-caption={caption ?? ''} />
  </div>
  {caption && (
    <figcaption class="mt-3 text-center font-mono text-[10px] uppercase tracking-[0.18em] text-ink/45">
      {caption}
    </figcaption>
  )}
</figure>
