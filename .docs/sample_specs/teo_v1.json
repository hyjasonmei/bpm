{
  "meta": {
    "schemaVersion": "1.0",
    "tenant": "acme",
    "flowName": "差旅費報銷",
    "flowCode": "TEO",
    "flowVersion": 1,
    "createdAt": "2026-05-11T00:00:00Z",
    "createdBy": "u_demo",
    "language": "zh-TW",
    "notes": "Per workflow.ts TEO: employee → manager → finance(confirm) → finance(fin_review) → close. Inherits expense_with_threshold_v1's gateway: total >= 50000 routes through CFO+Finance+DeptHead 2-of-3 collection approval. Line items collapsed to scalars for v1."
  },
  "flow": {
    "nodes": [
      { "id": "start_1", "type": "startEvent", "label": "開始" },
      { "id": "task_apply", "type": "userTask", "label": "員工提交費用單" },
      { "id": "approval_manager", "type": "approval", "label": "主管簽核" },
      { "id": "gateway_threshold", "type": "gateway", "label": "明細總額 ≥ 5 萬？" },
      { "id": "approval_extra", "type": "approval", "label": "高額加簽 (any 2/3)" },
      { "id": "task_finance_confirm", "type": "userTask", "label": "確認列印" },
      { "id": "task_finance_review", "type": "userTask", "label": "財務審查" },
      { "id": "end_1", "type": "endEvent", "label": "結案" }
    ],
    "edges": [
      { "id": "e1", "source": "start_1", "target": "task_apply" },
      { "id": "e2", "source": "task_apply", "target": "approval_manager" },
      { "id": "e3", "source": "approval_manager", "target": "gateway_threshold" },
      { "id": "e4", "source": "gateway_threshold", "target": "approval_extra", "condition": "total_amount >= 50000", "label": "5 萬以上需加簽" },
      { "id": "e5", "source": "gateway_threshold", "target": "task_finance_confirm", "condition": "total_amount < 50000", "isDefault": true, "label": "5 萬以下直接列印" },
      { "id": "e6", "source": "approval_extra", "target": "task_finance_confirm" },
      { "id": "e7", "source": "task_finance_confirm", "target": "task_finance_review" },
      { "id": "e8", "source": "task_finance_review", "target": "end_1" }
    ]
  },
  "userTasks": [
    {
      "id": "task_apply",
      "formCode": "TEO_APPLY",
      "fields": [
        { "id": "trq_no", "label": { "zh-TW": "對應差旅單號", "en": "Travel Request No." }, "type": "text", "required": false, "hint": { "zh-TW": "對應之 TRQ 單號" } },
        { "id": "destination", "label": { "zh-TW": "出差地點", "en": "Destination" }, "type": "text", "required": true },
        { "id": "purpose", "label": { "zh-TW": "出差目的", "en": "Purpose" }, "type": "textarea", "required": true },
        { "id": "travel_dates", "label": { "zh-TW": "出差期間" }, "type": "daterange", "required": true },
        { "id": "actual_amount", "label": { "zh-TW": "實際金額", "en": "Actual Amount" }, "type": "number", "required": true, "validator": "value > 0" },
        { "id": "total_amount", "label": { "zh-TW": "明細總額", "en": "Total" }, "type": "derived", "required": false, "derivedFrom": "actual_amount" },
        { "id": "expense_breakdown", "label": { "zh-TW": "收據明細", "en": "Expense Breakdown" }, "type": "textarea", "required": true, "hint": { "zh-TW": "每行一筆 (品項, 金額, 幣別)" } },
        { "id": "receipts", "label": { "zh-TW": "收據附件", "en": "Receipts" }, "type": "file", "required": true }
      ],
      "permissions": { "submitter": "self", "viewers": ["self", "manager", "role:Finance"] }
    },
    {
      "id": "task_finance_confirm",
      "formCode": "TEO_FINANCE_CONFIRM",
      "fields": [
        { "id": "print_no", "label": { "zh-TW": "列印單號", "en": "Print No." }, "type": "text", "required": true },
        { "id": "confirm_note", "label": { "zh-TW": "確認備註" }, "type": "textarea", "required": false }
      ],
      "permissions": { "submitter": "role:Finance", "viewers": ["role:Finance", "self", "manager"] }
    },
    {
      "id": "task_finance_review",
      "formCode": "TEO_FINANCE_REVIEW",
      "fields": [
        { "id": "review_note", "label": { "zh-TW": "審查備註" }, "type": "textarea", "required": false },
        { "id": "paid_at", "label": { "zh-TW": "撥款日期", "en": "Paid At" }, "type": "date", "required": true }
      ],
      "permissions": { "submitter": "role:Finance", "viewers": ["role:Finance", "self", "manager"] }
    }
  ],
  "decisions": [
    {
      "id": "gateway_threshold",
      "type": "exclusive",
      "branches": [
        { "edgeId": "e4", "condition": "total_amount >= 50000" },
        { "edgeId": "e5", "condition": "total_amount < 50000", "isDefault": true }
      ]
    }
  ],
  "approvals": [
    { "id": "approval_manager", "approver": { "type": "expr", "path": "submitter.manager" } },
    {
      "id": "approval_extra",
      "approver": {
        "type": "collection",
        "mode": "any",
        "min_approvals": 2,
        "actors": [
          { "type": "expr", "path": "submitter.department.head" },
          { "type": "role", "code": "Finance" },
          { "type": "role", "code": "CEO" }
        ]
      }
    }
  ],
  "notifications": [
    {
      "id": "notify_submit",
      "trigger": "on_submit",
      "channel": ["email", "in_app"],
      "recipients": [{ "type": "submitter" }],
      "template": {
        "subject": { "zh-TW": "差旅費用單已提交 ({{expense.amount}})" },
        "body": { "zh-TW": "您於 {{submitDate}} 提交的差旅費用 {{expense.amount}} 已進入核准流程。" },
        "variables": ["submitDate", "expense.amount"]
      }
    },
    {
      "id": "notify_assign",
      "trigger": "on_assign",
      "channel": ["email", "in_app"],
      "recipients": [{ "type": "current_approver" }],
      "template": {
        "subject": { "zh-TW": "【差旅費報銷待簽】{{applicant.name}} - {{expense.amount}}" },
        "body": { "zh-TW": "申請人: {{applicant.name}}\n金額: {{expense.amount}}\n地點: {{trip.destination}}\n\n請點此核准: {{caseUrl}}" },
        "variables": ["applicant.name", "expense.amount", "trip.destination", "caseUrl"]
      }
    },
    {
      "id": "notify_complete",
      "trigger": "on_complete",
      "channel": ["email"],
      "recipients": [{ "type": "submitter" }],
      "template": {
        "subject": { "zh-TW": "您的差旅費報銷已完成" },
        "body": { "zh-TW": "您於 {{submitDate}} 提交的 {{trip.destination}} 差旅費用 {{expense.amount}} 已核銷完畢。" },
        "variables": ["submitDate", "trip.destination", "expense.amount"]
      }
    }
  ],
  "sla": {
    "perNode": {
      "approval_manager": { "duration": "16h", "businessHoursOnly": true },
      "approval_extra": { "duration": "24h", "businessHoursOnly": true },
      "task_finance_confirm": { "duration": "16h", "businessHoursOnly": true },
      "task_finance_review": { "duration": "24h", "businessHoursOnly": true }
    }
  },
  "integrations": {
    "identityProvider": "csv",
    "csvSource": { "url": "s3://bpm-tenants/acme/employees-2026-05-11.csv" },
    "fieldMappings": {
      "employeeId": "empId",
      "displayName": "name",
      "email": "email",
      "reportsTo": "manager",
      "department": "department",
      "title": "title"
    }
  },
  "testCases": [
    {
      "id": "tc_small_under_threshold",
      "name": "5,000 元市內車馬、低於 5 萬無加簽",
      "inputs": {
        "trq_no": "",
        "destination": "Taichung",
        "purpose": "客戶拜訪",
        "travel_dates": { "start": "2026-05-08", "end": "2026-05-08" },
        "actual_amount": 5000,
        "total_amount": 5000,
        "expense_breakdown": "高鐵 1500\n計程車 1500\n餐費 2000",
        "receipts": "receipts.pdf"
      },
      "expectedTrace": ["start_1", "task_apply", "approval_manager", "gateway_threshold", "task_finance_confirm", "task_finance_review", "end_1"],
      "expectedFinalStatus": "Completed",
      "expectedNotifications": [
        { "trigger": "on_assign", "recipientCount": 1 },
        { "trigger": "on_complete", "recipientCount": 1 }
      ]
    },
    {
      "id": "tc_large_over_threshold_2of3",
      "name": "97,000 元 Dubai 出差、加簽 any 2/3 通過",
      "inputs": {
        "trq_no": "TW-TRQ-26-000160",
        "destination": "Dubai, UAE",
        "purpose": "DMCC 2026 RSM auditing",
        "travel_dates": { "start": "2026-04-29", "end": "2026-05-06" },
        "actual_amount": 97000,
        "total_amount": 97000,
        "expense_breakdown": "Airfare 50400\nHotel 44652\nTaxi 1948",
        "receipts": "receipts.zip"
      },
      "expectedTrace": ["start_1", "task_apply", "approval_manager", "gateway_threshold", "approval_extra", "task_finance_confirm", "task_finance_review", "end_1"],
      "expectedFinalStatus": "Completed"
    },
    {
      "id": "tc_reject_by_manager",
      "name": "主管退件 → 流程結束於 Errored",
      "inputs": {
        "destination": "Tokyo",
        "purpose": "rejected case",
        "travel_dates": { "start": "2026-05-01", "end": "2026-05-02" },
        "actual_amount": 12000,
        "total_amount": 12000,
        "expense_breakdown": "x",
        "receipts": "x.pdf"
      },
      "managerDecision": "reject",
      "expectedTrace": ["start_1", "task_apply", "approval_manager"],
      "expectedFinalStatus": "Errored"
    }
  ]
}
