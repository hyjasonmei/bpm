{
  "meta": {
    "schemaVersion": "1.0",
    "tenant": "acme",
    "flowName": "IT 軟體 / 服務採購",
    "flowCode": "ITPR",
    "flowVersion": 1,
    "createdAt": "2026-05-11T00:00:00Z",
    "createdBy": "u_demo",
    "language": "zh-TW",
    "notes": "Per workflow.ts ITPR: employee → it × 2 (it_spec, quote) → manager × 2 (confirm userTask, approve approval) → finance(po) → close. Line items collapsed to scalars for v1."
  },
  "flow": {
    "nodes": [
      { "id": "start_1", "type": "startEvent", "label": "開始" },
      { "id": "task_apply", "type": "userTask", "label": "員工申請" },
      { "id": "task_it_spec", "type": "userTask", "label": "IT 規格審查" },
      { "id": "task_it_quote", "type": "userTask", "label": "比價報價" },
      { "id": "task_confirm", "type": "userTask", "label": "確認列印" },
      { "id": "approval_manager", "type": "approval", "label": "主管簽核" },
      { "id": "task_finance_po", "type": "userTask", "label": "採購單處理" },
      { "id": "end_1", "type": "endEvent", "label": "結案" }
    ],
    "edges": [
      { "id": "e1", "source": "start_1", "target": "task_apply" },
      { "id": "e2", "source": "task_apply", "target": "task_it_spec" },
      { "id": "e3", "source": "task_it_spec", "target": "task_it_quote" },
      { "id": "e4", "source": "task_it_quote", "target": "task_confirm" },
      { "id": "e5", "source": "task_confirm", "target": "approval_manager" },
      { "id": "e6", "source": "approval_manager", "target": "task_finance_po" },
      { "id": "e7", "source": "task_finance_po", "target": "end_1" }
    ]
  },
  "userTasks": [
    {
      "id": "task_apply",
      "formCode": "ITPR_APPLY",
      "fields": [
        {
          "id": "category",
          "label": { "zh-TW": "請購類別", "en": "Category" },
          "type": "select",
          "required": true,
          "options": [
            { "value": "software", "label": "軟體" },
            { "value": "saas", "label": "SaaS" },
            { "value": "service", "label": "服務" }
          ]
        },
        { "id": "item_name", "label": { "zh-TW": "商品名稱", "en": "Item" }, "type": "text", "required": true },
        { "id": "vendor_name", "label": { "zh-TW": "廠商名稱", "en": "Vendor" }, "type": "text", "required": true },
        { "id": "spec", "label": { "zh-TW": "規格說明", "en": "Spec" }, "type": "textarea", "required": true },
        { "id": "estimated_amount", "label": { "zh-TW": "預計金額", "en": "Estimated Amount" }, "type": "number", "required": true, "validator": "value > 0" },
        {
          "id": "currency",
          "label": { "zh-TW": "幣別", "en": "Currency" },
          "type": "select",
          "required": true,
          "options": [
            { "value": "TWD", "label": "TWD" },
            { "value": "USD", "label": "USD" }
          ]
        },
        { "id": "purpose", "label": { "zh-TW": "用途", "en": "Purpose" }, "type": "textarea", "required": false },
        { "id": "expected_date", "label": { "zh-TW": "預計到期日", "en": "Expected Date" }, "type": "date", "required": false }
      ],
      "permissions": { "submitter": "self", "viewers": ["self", "manager", "role:IT", "role:Finance"] }
    },
    {
      "id": "task_it_spec",
      "formCode": "ITPR_IT_SPEC",
      "fields": [
        { "id": "spec_review", "label": { "zh-TW": "規格審查意見", "en": "Spec Review" }, "type": "textarea", "required": true },
        {
          "id": "spec_decision",
          "label": { "zh-TW": "審查結果", "en": "Decision" },
          "type": "select",
          "required": true,
          "options": [
            { "value": "approved", "label": "核准" },
            { "value": "needs_change", "label": "需修改" }
          ]
        }
      ],
      "permissions": { "submitter": "role:IT", "viewers": ["role:IT", "self", "manager"] }
    },
    {
      "id": "task_it_quote",
      "formCode": "ITPR_QUOTE",
      "fields": [
        { "id": "quote_amount", "label": { "zh-TW": "報價金額", "en": "Quoted Amount" }, "type": "number", "required": true, "validator": "value > 0" },
        { "id": "quote_currency", "label": { "zh-TW": "報價幣別" }, "type": "select", "required": true,
          "options": [
            { "value": "TWD", "label": "TWD" },
            { "value": "USD", "label": "USD" }
          ] },
        { "id": "quote_no", "label": { "zh-TW": "報價單號", "en": "Quote No." }, "type": "text", "required": true },
        { "id": "quote_file", "label": { "zh-TW": "報價單", "en": "Quote File" }, "type": "file", "required": true },
        { "id": "quote_note", "label": { "zh-TW": "比價備註" }, "type": "textarea", "required": false }
      ],
      "permissions": { "submitter": "role:IT", "viewers": ["role:IT", "self", "manager", "role:Finance"] }
    },
    {
      "id": "task_confirm",
      "formCode": "ITPR_CONFIRM",
      "fields": [
        { "id": "print_no", "label": { "zh-TW": "列印單號", "en": "Print No." }, "type": "text", "required": true },
        { "id": "confirm_note", "label": { "zh-TW": "確認備註" }, "type": "textarea", "required": false }
      ],
      "permissions": { "submitter": "manager", "viewers": ["manager", "self", "role:IT"] }
    },
    {
      "id": "task_finance_po",
      "formCode": "ITPR_FINANCE_PO",
      "fields": [
        { "id": "po_number", "label": { "zh-TW": "採購單號", "en": "PO Number" }, "type": "text", "required": true },
        { "id": "po_date", "label": { "zh-TW": "採購單日期", "en": "PO Date" }, "type": "date", "required": true },
        { "id": "po_note", "label": { "zh-TW": "備註" }, "type": "textarea", "required": false }
      ],
      "permissions": { "submitter": "role:Finance", "viewers": ["role:Finance", "self", "manager", "role:IT"] }
    }
  ],
  "decisions": [],
  "approvals": [
    { "id": "approval_manager", "approver": { "type": "expr", "path": "submitter.manager" } }
  ],
  "notifications": [
    {
      "id": "notify_assign",
      "trigger": "on_assign",
      "channel": ["email", "in_app"],
      "recipients": [{ "type": "current_approver" }],
      "template": {
        "subject": { "zh-TW": "【IT 採購待處理】{{applicant.name}} - {{item.name}}" },
        "body": { "zh-TW": "申請人: {{applicant.name}}\n商品: {{item.name}}\n廠商: {{vendor.name}}\n預計金額: {{estimated.amount}}\n\n請點此處理: {{caseUrl}}" },
        "variables": ["applicant.name", "item.name", "vendor.name", "estimated.amount", "caseUrl"]
      }
    },
    {
      "id": "notify_complete",
      "trigger": "on_complete",
      "channel": ["email"],
      "recipients": [{ "type": "submitter" }],
      "template": {
        "subject": { "zh-TW": "您的 IT 採購已完成 PO 開立" },
        "body": { "zh-TW": "您的 {{item.name}} 採購單號 {{po.number}} 已開立。" },
        "variables": ["item.name", "po.number"]
      }
    }
  ],
  "sla": {
    "perNode": {
      "task_it_spec": { "duration": "16h", "businessHoursOnly": true },
      "task_it_quote": { "duration": "24h", "businessHoursOnly": true },
      "approval_manager": { "duration": "16h", "businessHoursOnly": true, "escalation": { "after": "16h", "action": "notify" } },
      "task_finance_po": { "duration": "48h", "businessHoursOnly": true }
    }
  },
  "integrations": {
    "identityProvider": "csv",
    "csvSource": { "url": "s3://bpm-tenants/acme/employees-2026-05-11.csv" },
    "fieldMappings": {
      "employeeId": "empId",
      "displayName": "name",
      "email": "email",
      "reportsTo": "manager",
      "department": "department",
      "title": "title"
    }
  },
  "testCases": [
    {
      "id": "tc_happy_powerbi",
      "name": "Power BI 訂閱、IT 審 → 比價 → 主管核准 → PO",
      "inputs": {
        "category": "saas",
        "item_name": "Power BI Pro",
        "vendor_name": "Microsoft",
        "spec": "4 seats x 3 years",
        "estimated_amount": 26352,
        "currency": "TWD",
        "purpose": "Finance dashboard 升級",
        "expected_date": "2026-07-01"
      },
      "expectedTrace": ["start_1", "task_apply", "task_it_spec", "task_it_quote", "task_confirm", "approval_manager", "task_finance_po", "end_1"],
      "expectedFinalStatus": "Completed",
      "expectedNotifications": [
        { "trigger": "on_assign", "recipientCount": 1 },
        { "trigger": "on_complete", "recipientCount": 1 }
      ]
    },
    {
      "id": "tc_reject_by_manager",
      "name": "主管退件 → 流程結束於 Errored",
      "inputs": {
        "category": "software",
        "item_name": "Photoshop",
        "vendor_name": "Adobe",
        "spec": "1 seat",
        "estimated_amount": 800,
        "currency": "USD"
      },
      "managerDecision": "reject",
      "expectedTrace": ["start_1", "task_apply", "task_it_spec", "task_it_quote", "task_confirm", "approval_manager"],
      "expectedFinalStatus": "Errored"
    }
  ]
}
